---
interface Props {
  role: 'internal' | 'grower' | 'buyer' | 'driver';
}
const { role } = Astro.props;
const base = import.meta.env.BASE_URL;

const config = {
  internal: {
    label: 'INTERNE VERWALTUNG',
    detail: 'Nadine / Roland · nicht öffentlich'
  },
  grower: {
    label: 'WINZERPORTAL',
    detail: 'Externe Ansicht · nur eigene Betriebsdaten'
  },
  buyer: {
    label: 'ABNEHMER / KELLEREI',
    detail: 'Externe Ansicht · eigene Bedarfe und Lieferstände'
  },
  driver: {
    label: 'SPEDITION / FAHRER',
    detail: 'Externe Ansicht · nur zugewiesene Transporte'
  }
}[role];
---

<div class:list={['role-context', role]}>
  <div>
    <strong>{config.label}</strong>
    <span>{config.detail}</span>
  </div>
  <a href={`${base}demo/`}>Demo-Zentrale</a>
</div>

<style>
  .role-context{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:9px 14px;font-family:Arial,sans-serif}
  .role-context>div{display:flex;gap:10px;align-items:baseline;min-width:0}
  .role-context strong{font-size:8px;letter-spacing:.11em}
  .role-context span{font-size:8px;opacity:.72}
  .role-context a{font-size:8px;text-decoration:none;white-space:nowrap}
  .role-context.internal{background:#102d38;color:#fcfaf5;border-bottom:1px solid rgba(255,255,255,.12)}
  .role-context.internal a{color:#d8c4af}
  .role-context.grower,
  .role-context.buyer,
  .role-context.driver{background:#102d38;color:#fcfaf5;border-bottom:1px solid rgba(255,255,255,.12)}
  .role-context.grower a,
  .role-context.buyer a,
  .role-context.driver a{color:#d8c4af}
  @media(max-width:620px){
    .role-context{align-items:flex-start}
    .role-context>div{display:grid;gap:2px}
    .role-context span{font-size:7px}
  }
</style>
