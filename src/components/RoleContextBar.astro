---
interface Props {
  role: 'internal' | 'grower';
}
const { role } = Astro.props;
const base = import.meta.env.BASE_URL;
const internal = role === 'internal';
---

<div class:list={['role-context', internal ? 'internal' : 'grower']}>
  <div>
    <strong>{internal ? 'INTERNE VERWALTUNG' : 'WINZERPORTAL'}</strong>
    <span>{internal ? 'Nadine / Roland · nicht öffentlich' : 'Externe Ansicht · nur eigene Betriebsdaten'}</span>
  </div>
  <a href={`${base}demo/`}>Demo-Zentrale</a>
</div>

<style>
  .role-context{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:9px 14px;font-family:Arial,sans-serif}
  .role-context>div{display:flex;gap:10px;align-items:baseline;min-width:0}
  .role-context strong{font-size:8px;letter-spacing:.11em}
  .role-context span{font-size:8px;opacity:.7}
  .role-context a{font-size:8px;text-decoration:none;white-space:nowrap}
  .role-context.internal{background:#142920;color:#fff;border-bottom:1px solid rgba(255,255,255,.12)}
  .role-context.internal a{color:#e8d5af}
  .role-context.grower{background:#efe7d7;color:#19342a;border-bottom:1px solid rgba(25,52,42,.14)}
  .role-context.grower a{color:#19342a}
  @media(max-width:620px){
    .role-context{align-items:flex-start}
    .role-context>div{display:grid;gap:2px}
    .role-context span{font-size:7px}
  }
</style>
