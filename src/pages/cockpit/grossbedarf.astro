---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/cockpit.css';
import '../../styles/grossbedarf.css';
import { demoRequirement, demoGrowers } from '../../data/procurement-demo.js';
import { runProcurement, formatLiters } from '../../lib/procurementEngine.js';

const base = import.meta.env.BASE_URL;
const model = runProcurement(demoRequirement, demoGrowers);
const displayRows = model.allocationRows.slice(0, 40);
const topExceptions = model.exceptions.slice(0, 3);
const topTransports = model.transports.slice(0, 3);
const coveragePercent = (model.coverage * 100).toFixed(1).replace('.', ',');
---

<BaseLayout
  title="Großbedarf · Porn Cockpit"
  description="Orchestrierung eines gebündelten Weinbedarfs über viele Winzer, Partien, Transporte und Begleitdokumente."
  canonicalPath="/weinkommission/cockpit/grossbedarf/"
>
  <div class="cockpit-app procurement-app">
    <aside class="sidebar" aria-label="Cockpit Navigation">
      <a class="cockpit-brand" href={base}>
        <span class="brand-mark">WP</span>
        <span><strong>WEINKOMMISSION PORN</strong><small>Mosel · Cockpit</small></span>
      </a>

      <nav class="side-nav">
        <a href={`${base}cockpit/`}><span class="nav-icon">⌂</span><span>Übersicht</span></a>
        <a class="active" href="#auftrag" aria-current="page"><span class="nav-icon">◎</span><span>Großbedarf</span></a>
        <a href="#winzer"><span class="nav-icon">○</span><span>Winzer</span></a>
        <a href="#ausnahmen"><span class="nav-icon">!</span><span>Ausnahmen</span></a>
        <a href="#transporte"><span class="nav-icon">↗</span><span>Transporte</span></a>
      </nav>

      <div class="sidebar-foot">
        <div class="api-state">
          <span class="state-dot pending"></span>
          <div><strong>Workflow Engine</strong><small>Demo · keine Echtdaten</small></div>
        </div>
        <a class="back-link" href={`${base}cockpit/`}>← Cockpit</a>
      </div>
    </aside>

    <main class="cockpit-main procurement-main" id="main">
      <header class="procurement-header" id="auftrag">
        <div>
          <p class="overline">Beschaffungsvorgang · Beispieldaten</p>
          <h1>Peter Mertes × Blaues Band</h1>
          <p class="procurement-lead">Ein Bedarf, viele Winzer. Das System verteilt, sammelt, prüft und eskaliert nur die Fälle, bei denen ein Mensch wirklich gebraucht wird.</p>
        </div>
        <div class="header-controls">
          <span class="scenario-badge">Demo-Szenario</span>
          <button class="quiet-button" type="button" data-open-spec>Bedarf ansehen</button>
          <button class="primary-button" type="button" data-run-auto>3 Winzer-Rückmeldungen simulieren</button>
        </div>
      </header>

      <section class="mobile-command" aria-label="Mobile Übersicht">
        <div class="mobile-command-top">
          <div>
            <p class="overline">Auf einen Blick</p>
            <strong data-mobile-coverage>{coveragePercent} % gedeckt</strong>
          </div>
          <span data-mobile-remaining>{formatLiters(model.remainingVolume)} offen</span>
        </div>
        <div class="mobile-metrics">
          <a href="#ausnahmen"><span>Ausnahmen</span><strong>{model.stats.exceptionCount}</strong></a>
          <a href="#winzer"><span>Winzer-Aufgaben</span><strong data-mobile-tasks>{model.tasks.length}</strong></a>
          <a href="#transporte"><span>Transporte</span><strong>{model.stats.transports}</strong></a>
        </div>
      </section>

      <section class="master-order">
        <div class="order-identity">
          <span class="order-code">{demoRequirement.id}</span>
          <div>
            <p class="overline">Gesamtbedarf</p>
            <h2>{demoRequirement.grape} · {demoRequirement.origin} · Jahrgang {demoRequirement.vintage}</h2>
          </div>
        </div>

        <div class="order-spec" data-order-spec>
          <div><span>Zielmenge</span><strong>{formatLiters(demoRequirement.targetVolume)}</strong></div>
          <div><span>Abnehmer</span><strong>{demoRequirement.buyer}</strong></div>
          <div><span>Lieferfenster</span><strong>{demoRequirement.deliveryWindow}</strong></div>
          <div><span>Winzerverbund</span><strong>{demoRequirement.supplierGroup} · {model.stats.growersTotal} Betriebe</strong></div>
        </div>

        <div class="coverage">
          <div class="coverage-head">
            <div><span class="overline">Mengenabdeckung</span><strong data-coverage-label>{formatLiters(model.allocatedVolume)} zugeteilt</strong></div>
            <span data-coverage-percent>{coveragePercent} %</span>
          </div>
          <div class="coverage-track"><span data-coverage-bar style={`width:${model.coverage * 100}%`}></span></div>
          <div class="coverage-scale"><span>0 l</span><span data-remaining>noch {formatLiters(model.remainingVolume)} offen</span><span>{formatLiters(demoRequirement.targetVolume)}</span></div>
        </div>
      </section>

      <section class="orchestration">
        <div class="section-heading">
          <div>
            <p class="overline">Orchestrierung</p>
            <h2>Der Auftrag arbeitet sich selbst ab.</h2>
          </div>
          <p>Das System übernimmt Standardfälle automatisch. Nur echte Abweichungen landen bei Nadine oder Roland.</p>
        </div>

        <button class="mobile-section-toggle" type="button" data-toggle-flow aria-expanded="false">Automationsablauf anzeigen <span>+</span></button>
        <div class="flow-strip" data-flow-strip>
          <div class="flow-node done">
            <span>Bedarf</span>
            <strong>erfasst</strong>
            <small>Spezifikation zentral hinterlegt</small>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-node active">
            <span>Matching</span>
            <strong data-flow-matching>{model.stats.eligibleLots} Partien fachlich passend</strong>
            <small>nach Weinart, Herkunft, Analytik, Menge</small>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-node active">
            <span>Zuteilung</span>
            <strong data-flow-allocation>{model.stats.growersAllocated} Betriebe zugeteilt</strong>
            <small>Mengen automatisch reserviert</small>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-node">
            <span>Transport</span>
            <strong>laufend</strong>
            <small>Termine + Verladedaten einsammeln</small>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-node">
            <span>Begleitdokument</span>
            <strong>automatisch vorbereitet</strong>
            <small>nur Ausnahmen manuell</small>
          </div>
        </div>
      </section>

      <section class="exception-command" id="ausnahmen">
        <div class="exception-copy">
          <p class="overline">Nadines Arbeitsliste</p>
          <h2>Nur das, was nicht automatisch weiterläuft.</h2>
          <p>In diesem Demo-Szenario laufen die meisten Vorgänge ohne Eingriff. Diese Fälle blockieren aktuell den Gesamtprozess.</p>
        </div>

        <div class="exception-list" data-exception-list>
          {topExceptions.map((item) => (
            <button type="button" data-filter={item.type === 'missing-data' ? 'waiting' : 'exception'}>
              <span class:list={['exception-severity', item.type === 'missing-data' ? 'medium' : 'high']}>{item.type === 'missing-data' ? 'wartet' : 'prüfen'}</span>
              <div><strong>{item.growerName} · {item.lotId}</strong><small>{item.detail}</small></div>
              <span>{item.type === 'missing-data' ? 'Winzeraufgabe öffnen →' : 'Ausnahme prüfen →'}</span>
            </button>
          ))}
        </div>
      </section>

      <section class="grower-allocation" id="winzer">
        <div class="allocation-head">
          <div>
            <p class="overline">Winzer & Partien</p>
            <h2>Zuteilungen im Gesamtauftrag</h2>
          </div>
          <div class="allocation-tools">
            <label class="search-field">
              <span class="sr-only">Winzer suchen</span>
              <input type="search" placeholder="Winzer oder Partie suchen" data-search />
            </label>
            <select data-status-filter aria-label="Status filtern">
              <option value="all">Alle Status</option>
              <option value="ready">bereit</option>
              <option value="waiting">wartet auf Winzer</option>
              <option value="exception">Ausnahme</option>
              <option value="transport">Transport geplant</option>
              <option value="document">Dokument bereit</option>
              <option value="reserve">Reserve</option>
            </select>
          </div>
        </div>

        <div class="allocation-summary">
          <span><strong data-visible-count>{displayRows.length}</strong> Datensätze sichtbar</span>
          <span><strong>{model.stats.growersTotal}</strong> Betriebe im Demo-Verbund</span>
          <span><strong data-allocated-count>{model.stats.growersAllocated}</strong> aktuell zugeteilt</span>
          <span><strong data-task-count>{model.tasks.length}</strong> offene Auto-Aufgaben</span>
        </div>

        <div class="allocation-table" role="table" aria-label="Winzerzuteilungen">
          <div class="allocation-row allocation-head-row" role="row">
            <span>Winzer</span><span>Partie</span><span>Angeboten</span><span>Zugeordnet</span><span>Status</span><span>Hinweis</span>
          </div>
          {displayRows.map((g) => (
            <a
              href={`${base}cockpit/winzer/${g.growerId}/`}
              class="allocation-row allocation-data-row"
              data-grower-row
              data-status={g.status}
              data-search-text={`${g.growerName} ${g.place} ${g.lotId} ${g.grape} ${g.vintage}`.toLowerCase()}
              role="row"
            >
              <span class="grower-name" data-label="Winzer"><strong>{g.growerName}</strong><small>{g.place}</small></span>
              <span data-label="Partie"><strong>{g.lotId}</strong><small>{g.grape} · {g.vintage}</small></span>
              <span data-label="Angeboten">{formatLiters(g.availableVolume)}</span>
              <span data-label="Zugeordnet">{formatLiters(g.allocatedVolume)}</span>
              <span data-label="Status"><em class:list={['row-status', g.status]}>{g.label}</em></span>
              <span class="issue-text" data-label="Hinweis">{g.issue || '—'}</span>
            </a>
          ))}
        </div>
        <button class="mobile-more" type="button" data-mobile-more>Weitere Treffer anzeigen</button>
      </section>

      <section class="automation-engine">
        <div class="engine-copy">
          <p class="overline">Automationslogik</p>
          <h2>Was im Hintergrund automatisch passiert.</h2>
        </div>
        <button class="mobile-section-toggle" type="button" data-toggle-engine aria-expanded="false">Automationslogik anzeigen <span>+</span></button>
        <div class="engine-steps" data-engine-steps>
          <article><span>01</span><strong>Bedarf normalisieren</strong><p>Ein Bedarf wird in strukturierte Kriterien übersetzt: Erzeugnis, Herkunft, Analytik, Menge, Zeitraum und weitere Vorgaben.</p></article>
          <article><span>02</span><strong>Passende Partien finden</strong><p>Nur hinterlegte und fachlich passende Partien werden vorgeschlagen. Fehlende Angaben werden gezielt beim betreffenden Winzer angefragt.</p></article>
          <article><span>03</span><strong>Mengen verteilen</strong><p>Zuteilungen berücksichtigen verfügbare Mengen und verhindern Doppelbelegung derselben Partie.</p></article>
          <article><span>04</span><strong>Ausnahmen eskalieren</strong><p>Abweichende Analysewerte, geänderte Mengen oder fehlende Angaben werden nicht versteckt, sondern an die richtige Person geroutet.</p></article>
          <article><span>05</span><strong>Transport erzeugen</strong><p>Nach bestätigter Zuteilung entstehen Transportvorgänge automatisch und übernehmen sämtliche vorhandenen Stammdaten.</p></article>
          <article><span>06</span><strong>Dokument vorbereiten</strong><p>Begleitdokumente entstehen aus dem Datenbestand. Menschen ergänzen nur die Werte, die erst bei der Verladung feststehen.</p></article>
        </div>
      </section>

      <section class="transport-wave" id="transporte">
        <div>
          <p class="overline">Nächste Verladewelle · Demo</p>
          <h2>Donnerstag · 24. September</h2>
        </div>
        <div class="wave-list" data-transport-list>
          {topTransports.map((t, index) => (
            <div>
              <span>{['07:30','09:15','11:00'][index] || '—'}</span>
              <strong>{t.growerName}</strong>
              <small>{formatLiters(t.volume)} · {t.lotId} · {t.state === 'waiting-for-loading-data' ? 'Verladedaten fehlen' : t.state === 'document-ready' ? 'Begleitdokument vorbereitet' : 'Transport vorbereitet'}</small>
              <em>{t.state === 'waiting-for-loading-data' ? 'Winzer' : 'automatisch'}</em>
            </div>
          ))}
        </div>
      </section>

      <dialog class="spec-dialog" data-spec-dialog>
        <button class="dialog-close" type="button" data-close-spec aria-label="Schließen">×</button>
        <p class="overline">Bedarf M-2027-RI-01 · Demo</p>
        <h2>Bedarfsspezifikation</h2>
        <dl>
          <div><dt>Erzeugnis</dt><dd>{demoRequirement.grape} · Wein</dd></div>
          <div><dt>Herkunft</dt><dd>{demoRequirement.origin}</dd></div>
          <div><dt>Jahrgang</dt><dd>{demoRequirement.vintage}</dd></div>
          <div><dt>Zielmenge</dt><dd>{formatLiters(demoRequirement.targetVolume)}</dd></div>
          <div><dt>Lieferfenster</dt><dd>{demoRequirement.deliveryWindow}</dd></div>
          <div><dt>Abnehmer</dt><dd>{demoRequirement.buyer}</dd></div>
        </dl>
        <p class="dialog-note">Analytische Grenzwerte sind hier bewusst als Demo nicht erfunden. In der produktiven Version werden sie exakt aus dem realen Mertes-Bedarf übernommen.</p>
      </dialog>

      <div class="toast" role="status" aria-live="polite" data-toast></div>
    </main>
  </div>

  <script>
    import { demoRequirement, demoGrowers } from '../../data/procurement-demo.js';
    import { runProcurement } from '../../lib/procurementEngine.js';

    let workingGrowers = demoGrowers.map(item => ({...item}));
    const rows = [...document.querySelectorAll('[data-grower-row]')];
    const statusFilter = document.querySelector('[data-status-filter]');
    const search = document.querySelector('[data-search]');
    const visibleCount = document.querySelector('[data-visible-count]');
    const toast = document.querySelector('[data-toast]');
    const specDialog = document.querySelector('[data-spec-dialog]');
    const moreButton = document.querySelector('[data-mobile-more]');
    const flowToggle = document.querySelector('[data-toggle-flow]');
    const engineToggle = document.querySelector('[data-toggle-engine]');
    let mobileExpanded = false;

    const formatLiters = value => new Intl.NumberFormat('de-DE').format(Math.round(value)) + ' l';

    function applyFilters() {
      const status = statusFilter.value;
      const term = search.value.trim().toLowerCase();
      const mobile = window.matchMedia('(max-width: 700px)').matches;
      const matched = rows.filter(row => {
        const matchesStatus = status === 'all' || row.dataset.status === status;
        const matchesSearch = !term || row.dataset.searchText.includes(term);
        return matchesStatus && matchesSearch;
      });

      rows.forEach(row => row.hidden = true);
      const shown = mobile && !mobileExpanded ? matched.slice(0, 8) : matched;
      shown.forEach(row => row.hidden = false);

      visibleCount.textContent = mobile && !mobileExpanded && matched.length > 8
        ? shown.length + ' von ' + matched.length
        : matched.length;

      if (moreButton) {
        moreButton.hidden = !mobile || matched.length <= 8;
        moreButton.textContent = mobileExpanded ? 'Weniger anzeigen' : 'Weitere ' + (matched.length - Math.min(8, matched.length)) + ' Treffer anzeigen';
      }
    }

    function updateHeadline(model) {
      const pct = (model.coverage * 100).toFixed(1).replace('.', ',');
      document.querySelector('[data-coverage-label]').textContent = formatLiters(model.allocatedVolume) + ' zugeteilt';
      document.querySelector('[data-coverage-percent]').textContent = pct + ' %';
      document.querySelector('[data-coverage-bar]').style.width = (model.coverage * 100) + '%';
      document.querySelector('[data-remaining]').textContent = 'noch ' + formatLiters(model.remainingVolume) + ' offen';
      document.querySelector('[data-flow-matching]').textContent = model.stats.eligibleLots + ' Partien fachlich passend';
      document.querySelector('[data-flow-allocation]').textContent = model.stats.growersAllocated + ' Betriebe zugeteilt';
      document.querySelector('[data-allocated-count]').textContent = model.stats.growersAllocated;
      document.querySelector('[data-task-count]').textContent = model.tasks.length;
      const mobileCoverage = document.querySelector('[data-mobile-coverage]');
      const mobileRemaining = document.querySelector('[data-mobile-remaining]');
      const mobileTasks = document.querySelector('[data-mobile-tasks]');
      if (mobileCoverage) mobileCoverage.textContent = pct + ' % gedeckt';
      if (mobileRemaining) mobileRemaining.textContent = formatLiters(model.remainingVolume) + ' offen';
      if (mobileTasks) mobileTasks.textContent = model.tasks.length;
    }

    statusFilter.addEventListener('change', () => { mobileExpanded = false; applyFilters(); });
    search.addEventListener('input', () => { mobileExpanded = false; applyFilters(); });
    window.addEventListener('resize', applyFilters);

    if (moreButton) moreButton.addEventListener('click', () => {
      mobileExpanded = !mobileExpanded;
      applyFilters();
    });

    if (flowToggle) flowToggle.addEventListener('click', () => {
      const strip = document.querySelector('[data-flow-strip]');
      const open = strip.classList.toggle('mobile-open');
      flowToggle.setAttribute('aria-expanded', String(open));
      flowToggle.querySelector('span').textContent = open ? '−' : '+';
    });

    if (engineToggle) engineToggle.addEventListener('click', () => {
      const steps = document.querySelector('[data-engine-steps]');
      const open = steps.classList.toggle('mobile-open');
      engineToggle.setAttribute('aria-expanded', String(open));
      engineToggle.querySelector('span').textContent = open ? '−' : '+';
    });

    document.querySelectorAll('[data-filter]').forEach(button => button.addEventListener('click', () => {
      statusFilter.value = button.dataset.filter;
      search.value = '';
      applyFilters();
      document.querySelector('#winzer').scrollIntoView({behavior:'smooth', block:'start'});
    }));

    document.querySelector('[data-open-spec]').addEventListener('click', () => specDialog.showModal());
    document.querySelector('[data-close-spec]').addEventListener('click', () => specDialog.close());

    document.querySelector('[data-run-auto]').addEventListener('click', (event) => {
      const button = event.currentTarget;
      button.disabled = true;
      button.textContent = 'Rückmeldungen werden verarbeitet …';

      const waiting = workingGrowers.filter(x => !x.analysisConfirmed || !x.treatmentsConfirmed || !x.currentVolumeConfirmed).slice(0,3);
      const ids = new Set(waiting.map(x => x.growerId));
      workingGrowers = workingGrowers.map(x => ids.has(x.growerId)
        ? {...x, analysisConfirmed:true, treatmentsConfirmed:true, currentVolumeConfirmed:true}
        : x
      );

      const model = runProcurement(demoRequirement, workingGrowers);
      window.setTimeout(() => {
        updateHeadline(model);
        button.textContent = '3 Rückmeldungen verarbeitet ✓';
        toast.textContent = 'Engine neu berechnet: Rückmeldungen geprüft, Matching und Zuteilungen aktualisiert.';
        toast.classList.add('show');
        window.setTimeout(() => toast.classList.remove('show'), 2800);
      }, 500);
    });

    applyFilters();
  </script>
</BaseLayout>
