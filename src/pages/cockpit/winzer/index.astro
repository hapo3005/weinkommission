---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RoleContextBar from '../../../components/RoleContextBar.astro';
import '../../../styles/cockpit.css';
import '../../../styles/winzerliste.css';
import { demoRequirement, demoGrowers, demoProcurementRows, getLotsForGrower } from '../../../data/procurement-demo.js';
import { runProcurement, formatLiters } from '../../../lib/procurementEngine.js';

const base = import.meta.env.BASE_URL;
const model = runProcurement(demoRequirement, demoProcurementRows);
const taskGrowers = new Set(model.tasks.map(task => task.growerId));
const exceptionGrowers = new Set(model.exceptions.map(item => item.growerId));

const partners = demoGrowers.map(grower => {
  const growerRows = model.allocationRows.filter(row => row.growerId === grower.growerId);
  const allocatedRows = growerRows.filter(row => row.allocatedVolume > 0);
  const allocation = allocatedRows[0] || growerRows.find(row => row.status === 'waiting') || null;
  const lots = getLotsForGrower(grower.growerId);
  const inBlueBand = grower.supplierGroups.includes('Blaues Band');
  const allocatedVolume = allocatedRows.reduce((sum, row) => sum + row.allocatedVolume, 0);

  let status = 'partner';
  let statusLabel = 'Kooperationspartner';
  let attention = '';

  if (taskGrowers.has(grower.growerId) || exceptionGrowers.has(grower.growerId)) {
    status = 'waiting';
    statusLabel = 'Rückmeldung offen';
    attention = model.tasks.find(task => task.growerId === grower.growerId)?.task || 'Ausnahme prüfen';
  } else if (allocatedVolume > 0) {
    status = allocation?.status || 'ready';
    statusLabel = allocation?.label || 'für Bedarf vorbereitet';
    attention = allocation?.issue || '';
  } else if (inBlueBand) {
    status = 'blueband';
    statusLabel = 'Blaues Band';
  }

  const currentLot = allocation || lots[0] || {};

  return {
    ...grower,
    inBlueBand,
    allocation: allocation ? {...allocation, allocatedVolume} : null,
    currentLot,
    lotCount: lots.length,
    status,
    statusLabel,
    attention
  };
});

const blueBandCount = partners.filter(p => p.inBlueBand).length;
const otherCount = partners.length - blueBandCount;
const openCount = partners.filter(p => p.status === 'waiting' || p.status === 'exception').length;
---

<BaseLayout
  title="Winzer · Porn Cockpit"
  description="Interne Übersicht der kooperierenden Winzer der Weinkommission Porn."
  canonicalPath="/weinkommission/cockpit/winzer/"
>
  <RoleContextBar role="internal" />
  <div class="cockpit-app partner-app">
    <aside class="sidebar" aria-label="Cockpit Navigation">
      <a class="cockpit-brand" href={base}>
        <span class="brand-mark">WP</span>
        <span><strong>WEINKOMMISSION PORN</strong><small>Mosel · Cockpit</small></span>
      </a>

      <nav class="side-nav">
        <a href={`${base}cockpit/`}><span class="nav-icon">⌂</span><span>Übersicht</span></a>
        <a class="active" href={`${base}cockpit/winzer/`} aria-current="page"><span class="nav-icon">○</span><span>Winzer</span></a>
        <a href={`${base}cockpit/grossbedarf/`}><span class="nav-icon">◎</span><span>Großbedarf</span></a>
        <a href={`${base}cockpit/begleitdokument/`}><span class="nav-icon">▤</span><span>Begleitdokumente</span></a>
      </nav>

      <div class="sidebar-foot">
        <div class="api-state">
          <span class="state-dot pending"></span>
          <div><strong>Partnerkartei</strong><small>Testdaten · Import offen</small></div>
        </div>
        <a class="back-link" href={`${base}cockpit/`}>← Cockpit</a>
      </div>
    </aside>

    <main class="cockpit-main partner-main" id="main">
      <header class="partner-header">
        <div>
          <p class="overline">Interne Partnerkartei</p>
          <h1>Winzer</h1>
          <p class="partner-lead">Alle Betriebe, mit denen die Weinkommission zusammenarbeitet. Verbundzugehörigkeiten wie „Blaues Band“ sind Eigenschaften des Winzers und können gezielt gefiltert werden.</p>
        </div>
        <div class="partner-head-actions">
          <span class="scenario-badge">synthetische Testdaten</span>
          <button class="primary-button" type="button" data-import>Reale Liste importieren</button>
        </div>
      </header>

      <section class="partner-stats" aria-label="Partnerübersicht">
        <button type="button" data-group-filter="all" class="active">
          <span>Kooperationspartner</span>
          <strong>{partners.length}</strong>
          <small>alle aktiven Testbetriebe</small>
        </button>
        <button type="button" data-group-filter="blueband">
          <span>Blaues Band</span>
          <strong>{blueBandCount}</strong>
          <small>Testzuordnung</small>
        </button>
        <button type="button" data-group-filter="other">
          <span>Sonstige Partner</span>
          <strong>{otherCount}</strong>
          <small>außerhalb Blaues Band</small>
        </button>
        <button type="button" data-status-filter-button="attention">
          <span>Aufmerksamkeit</span>
          <strong>{openCount}</strong>
          <small>offene Rückmeldungen</small>
        </button>
      </section>

      <section class="partner-note">
        <strong>Struktur steht, Echtdaten fehlen noch.</strong>
        <p>Die Übersicht ist die künftige zentrale Winzerkartei. Die aktuell angezeigten Betriebe und Blaues-Band-Zuordnungen sind ausschließlich Testdaten. Beim Import werden sie durch Rolands/Nadines reale Partnerliste ersetzt.</p>
      </section>

      <section class="access-center" aria-labelledby="access-title">
        <div class="access-head">
          <div>
            <p class="overline">Portalzugänge</p>
            <h2 id="access-title">Einladungen & Registrierungen</h2>
          </div>
          <a class="quiet-button access-demo-link" href={`${base}winzer/registrieren/`}>Registrierungsdemo öffnen →</a>
        </div>

        <div class="access-empty" data-access-empty>
          <strong>Noch keine Demo-Aktivität.</strong>
          <p>Starte im Winzerportal eine Einladung oder neue Kooperationsanfrage. Die Aktivität erscheint anschließend hier im selben Browser.</p>
        </div>

        <div class="access-feed" data-access-feed hidden></div>
      </section>

      <section class="partner-directory">
        <div class="directory-tools">
          <label class="partner-search">
            <span class="sr-only">Winzer suchen</span>
            <input type="search" placeholder="Winzer, Ort oder ID suchen" data-partner-search />
          </label>
          <select data-partner-group aria-label="Verbund filtern">
            <option value="all">Alle Kooperationen</option>
            <option value="blueband">Blaues Band</option>
            <option value="other">Sonstige Partner</option>
          </select>
          <select data-partner-status aria-label="Status filtern">
            <option value="all">Alle Status</option>
            <option value="attention">Aufmerksamkeit</option>
            <option value="allocated">Im Großbedarf zugeteilt</option>
            <option value="idle">Ohne aktuelle Zuteilung</option>
          </select>
        </div>

        <div class="directory-meta">
          <span><strong data-visible-partners>{partners.length}</strong> Winzer sichtbar</span>
          <span>Sortierung: Name</span>
        </div>

        <div class="partner-list">
          {partners.map((partner) => {
            const allocated = partner.allocation?.allocatedVolume || 0;
            const state =
              partner.status === 'waiting' || partner.status === 'exception' ? 'attention' :
              allocated > 0 ? 'allocated' : 'idle';

            const processStatus =
              state === 'attention' ? 'Rückmeldung erforderlich' :
              partner.status === 'document' ? 'Begleitdokument vorbereitet' :
              partner.status === 'transport' ? 'Transportdaten fehlen' :
              allocated > 0 ? 'Für diesen Bedarf vorbereitet' :
              'Aktuell keine Zuteilung';

            return (
              <a
                class="partner-row"
                href={`${base}cockpit/winzer/${partner.growerId}/`}
                data-partner-row
                data-grower-id={partner.growerId}
                data-open-count={model.tasks.filter(task => task.growerId === partner.growerId).length}
                data-allocated={allocated > 0 ? 'true' : 'false'}
                data-group={partner.inBlueBand ? 'blueband' : 'other'}
                data-state={state}
                data-search={`${partner.growerName} ${partner.place} ${partner.growerId}`.toLowerCase()}
              >
                <span class="partner-identity">
                  <small class="card-label">Betrieb</small>
                  <strong>{partner.growerName}</strong>
                  <small>{partner.place} · {partner.growerId}</small>
                </span>

                <span class="partner-cooperation">
                  <small class="card-label">Kooperation</small>
                  <em class:list={{blueband: partner.inBlueBand, other: !partner.inBlueBand}}>
                    {partner.inBlueBand ? 'Blaues Band' : 'Sonstiger Partner'}
                  </em>
                  <small>Testzuordnung</small>
                </span>

                <span class:list={['current-process', state]}>
                  <span class="process-heading">
                    <small class="card-label">Aktueller Vorgang · Peter Mertes</small>
                    <em>{processStatus}</em>
                  </span>

                  {allocated > 0 || state === 'attention' ? (
                    <span class="process-grid">
                      <span>
                        <small>Partie</small>
                        <strong>{partner.currentLot.lotId}</strong>
                        <em>{partner.currentLot.vintage} {partner.currentLot.grape}</em>
                      </span>
                      <span>
                        <small>Verfügbar</small>
                        <strong>{formatLiters(partner.currentLot.availableVolume)}</strong>
                        <em>laut aktueller Partie</em>
                      </span>
                      <span>
                        <small>Für Mertes zugeteilt</small>
                        <strong>{allocated > 0 ? formatLiters(allocated) : '—'}</strong>
                        <em>{partner.attention || (allocated > 0 ? 'für aktuellen Großbedarf' : 'noch nicht zugeteilt')}</em>
                      </span>
                    </span>
                  ) : (
                    <span class="process-empty">Dieser Betrieb ist derzeit keinem laufenden Mertes-Großbedarf zugeteilt.</span>
                  )}
                </span>

                <span class="partner-open">Betriebsakte öffnen →</span>
              </a>
            );
          })}
        </div>

        <button type="button" class="partner-more" data-partner-more>Weitere Winzer anzeigen</button>
      </section>

      <dialog class="import-dialog" data-import-dialog>
        <button class="dialog-close" type="button" data-close-import aria-label="Schließen">×</button>
        <p class="overline">Reale Partnerdaten</p>
        <h2>Die Testkartei wird später ersetzt.</h2>
        <p>Die echte Winzerübersicht kann aus Rolands/Nadines vorhandener Excel-, CSV- oder Adressliste importiert werden. Dabei übernehmen wir Namen, Betriebsnummern, Ansprechpartner, Kontaktdaten und die Zugehörigkeit zum Blauen Band.</p>
        <div class="import-fields">
          <span>Winzer/Betrieb</span>
          <span>Betriebsnummer</span>
          <span>Kontakt</span>
          <span>Blaues Band: Ja/Nein</span>
        </div>
        <button class="primary-button" type="button" data-close-import>Verstanden</button>
      </dialog>
    </main>
  </div>

  <script>
    import { getAllGrowerResponses, saveApprovedGrower, getApprovedGrowers } from '../../../lib/demoSession.js';

    const rows = [...document.querySelectorAll('[data-partner-row]')];
    const search = document.querySelector('[data-partner-search]');
    const group = document.querySelector('[data-partner-group]');
    const status = document.querySelector('[data-partner-status]');
    const count = document.querySelector('[data-visible-partners]');
    const more = document.querySelector('[data-partner-more]');
    const importDialog = document.querySelector('[data-import-dialog]');
    const accessEmpty = document.querySelector('[data-access-empty]');
    const accessFeed = document.querySelector('[data-access-feed]');
    let expanded = false;

    function escapeHtml(value = '') {
      return String(value).replace(/[&<>"']/g, char => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'
      })[char]);
    }

    function renderAccessActivity() {
      const account = JSON.parse(localStorage.getItem('wp-demo-grower-account') || 'null');
      const requests = JSON.parse(localStorage.getItem('wp-demo-registration-requests') || '[]');
      const items = [];

      if (account) {
        items.push(`
          <article class="access-item active">
            <span class="access-state">Aktiv</span>
            <div>
              <strong>${escapeHtml(account.businessName || account.growerId)}</strong>
              <small>${escapeHtml(account.growerId)} · bestehende Betriebsakte verknüpft</small>
            </div>
            <em>Portalzugang aktiviert</em>
          </article>`);
      }

      requests.forEach(request => {
        const state = request.status === 'approved' ? 'approved' : request.status === 'rejected' ? 'rejected' : 'review';
        const stateLabel = request.status === 'approved' ? 'Freigegeben' : request.status === 'rejected' ? 'Abgelehnt' : 'Prüfung';
        const membership = request.blueBandClaimed ? 'Blaues Band angegeben · unbestätigt' : 'keine Verbundangabe';
        const actions = request.status === 'approved'
          ? `<a class="access-action primary" href="${import.meta.env.BASE_URL}winzer/registrieren/?invite=${encodeURIComponent(request.growerId)}">Einladung öffnen →</a>`
          : request.status === 'rejected'
            ? `<span class="access-decision">keine weitere Aktion</span>`
            : `<div class="access-actions">
                <button type="button" data-approve-request="${escapeHtml(request.id)}">Freigeben & Einladung erstellen</button>
                <button type="button" class="reject" data-reject-request="${escapeHtml(request.id)}">Ablehnen</button>
              </div>`;

        items.push(`
          <article class="access-item ${state}">
            <span class="access-state">${stateLabel}</span>
            <div>
              <strong>${escapeHtml(request.businessName)}</strong>
              <small>${escapeHtml(request.place)} · ${escapeHtml(request.contact)}</small>
              <small>${membership}${request.growerId ? ' · ' + escapeHtml(request.growerId) : ''}</small>
            </div>
            <div class="access-item-action">${actions}</div>
          </article>`);
      });

      accessEmpty.hidden = items.length > 0;
      accessFeed.hidden = items.length === 0;
      accessFeed.innerHTML = items.join('');
    }

    function parseNumber(value) {
      const normalized = String(value || '').replace(/\./g,'').replace(',','.').replace(/[^0-9.]/g,'');
      return Number(normalized) || 0;
    }

    function buildApprovedGrower(request) {
      const suffix = String(request.id || Date.now()).replace(/\D/g,'').slice(-6).padStart(6,'0');
      const hectares = parseNumber(request.hectares) || 8.5;
      const annualProduction = parseNumber(request.typicalAnnualVolume) || Math.round(hectares * 8500);
      return {
        growerId: request.growerId || 'NEW-' + suffix,
        growerName: request.businessName,
        place: request.place,
        postcode: request.postcode,
        street: request.street,
        contactPerson: request.person,
        email: request.email,
        phone: request.phone,
        businessNumber: request.businessNumber || 'NEU-' + suffix,
        website: request.website || 'https://neu-' + suffix + '.example',
        dataStatus: 'synthetic-request',
        cooperationStatus: 'active',
        supplierGroups: [],
        membershipDataStatus: request.blueBandClaimed ? 'claimed-unverified' : 'not-claimed',
        profile: {
          completeness: 72,
          hectares,
          annualProduction,
          harvestVolume: Math.round(annualProduction * 1.12),
          typicalMarketVolume: annualProduction,
          storageCapacity: Math.round(annualProduction * 1.1),
          largestTank: 15000,
          maxLoadingVolume: 15000,
          grapes: request.grapes?.length ? request.grapes : ['Riesling'],
          offers: request.offers?.length ? request.offers : ['Fasswein'],
          flexibleRequests: true,
          loadingMethod: 'tank-truck'
        }
      };
    }

    function updateRequestStatus(id, status) {
      const requests = JSON.parse(localStorage.getItem('wp-demo-registration-requests') || '[]');
      const request = requests.find(item => item.id === id);
      if (!request) return;

      if (status === 'approved') {
        const grower = buildApprovedGrower(request);
        saveApprovedGrower(grower);
        request.growerId = grower.growerId;
        request.status = 'approved';
        request.approvedAt = new Date().toISOString();
      } else {
        request.status = 'rejected';
        request.rejectedAt = new Date().toISOString();
      }

      localStorage.setItem('wp-demo-registration-requests', JSON.stringify(requests));
      renderAccessActivity();
    }

    function applyResponseOverlay() {
      const responses = getAllGrowerResponses();
      rows.forEach(row => {
        const openCount = Number(row.dataset.openCount || 0);
        if (openCount <= 0) return;
        const resolvedLots = new Set((responses[row.dataset.growerId] || []).map(item => item.lotId));
        if (resolvedLots.size < openCount) return;

        row.dataset.state = row.dataset.allocated === 'true' ? 'allocated' : 'idle';
        const statusText = row.querySelector('.process-heading em');
        if (statusText) {
          statusText.textContent = row.dataset.allocated === 'true'
            ? 'Rückmeldung verarbeitet · Vorgang läuft weiter'
            : 'Keine offene Rückmeldung';
        }
      });

      const attentionCount = rows.filter(row => row.dataset.state === 'attention').length;
      const attentionStrong = document.querySelector('[data-status-filter-button] strong');
      if (attentionStrong) attentionStrong.textContent = String(attentionCount);
    }

    function applyFilters() {
      const term = search.value.trim().toLowerCase();
      const groupValue = group.value;
      const statusValue = status.value;

      const matches = rows.filter(row => {
        const groupMatch = groupValue === 'all' || row.dataset.group === groupValue;
        const statusMatch = statusValue === 'all' || row.dataset.state === statusValue;
        const searchMatch = !term || row.dataset.search.includes(term);
        return groupMatch && statusMatch && searchMatch;
      });

      const mobile = window.matchMedia('(max-width: 700px)').matches;
      const limit = mobile && !expanded ? 12 : matches.length;

      rows.forEach(row => row.hidden = true);
      matches.slice(0, limit).forEach(row => row.hidden = false);

      count.textContent = mobile && !expanded && matches.length > limit
        ? limit + ' von ' + matches.length
        : matches.length;

      more.hidden = !mobile || matches.length <= 12;
      if (!more.hidden) more.textContent = expanded ? 'Weniger anzeigen' : 'Weitere ' + (matches.length - 12) + ' Winzer anzeigen';
    }

    function setGroup(value) {
      group.value = value;
      expanded = false;
      applyFilters();
      document.querySelector('.partner-directory').scrollIntoView({behavior:'smooth', block:'start'});
    }

    document.querySelectorAll('[data-group-filter]').forEach(button => button.addEventListener('click', () => setGroup(button.dataset.groupFilter)));
    document.querySelector('[data-status-filter-button]').addEventListener('click', () => {
      status.value = 'attention';
      expanded = false;
      applyFilters();
      document.querySelector('.partner-directory').scrollIntoView({behavior:'smooth', block:'start'});
    });

    search.addEventListener('input', () => { expanded = false; applyFilters(); });
    group.addEventListener('change', () => { expanded = false; applyFilters(); });
    status.addEventListener('change', () => { expanded = false; applyFilters(); });
    window.addEventListener('resize', applyFilters);

    more.addEventListener('click', () => {
      expanded = !expanded;
      applyFilters();
    });

    accessFeed.addEventListener('click', event => {
      const approve = event.target.closest('[data-approve-request]');
      const reject = event.target.closest('[data-reject-request]');
      if (approve) updateRequestStatus(approve.dataset.approveRequest, 'approved');
      if (reject) updateRequestStatus(reject.dataset.rejectRequest, 'rejected');
    });

    document.querySelector('[data-import]').addEventListener('click', () => importDialog.showModal());
    document.querySelectorAll('[data-close-import]').forEach(button => button.addEventListener('click', () => importDialog.close()));

    applyResponseOverlay();
    applyFilters();
    renderAccessActivity();
  </script>
</BaseLayout>
