---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/cockpit.css';
import '../../../styles/winzerprofil.css';
import { demoRequirement, demoGrowers, demoProcurementRows, getLotsForGrower } from '../../../data/procurement-demo.js';
import { runProcurement, formatLiters } from '../../../lib/procurementEngine.js';

export function getStaticPaths() {
  return demoGrowers.map((grower) => ({
    params: { id: grower.growerId },
    props: { grower }
  }));
}

const { grower } = Astro.props;
const base = import.meta.env.BASE_URL;
const model = runProcurement(demoRequirement, demoProcurementRows);
const growerLots = getLotsForGrower(grower.growerId);
const growerRows = model.allocationRows.filter((row) => row.growerId === grower.growerId);
const allocatedRows = growerRows.filter((row) => row.allocatedVolume > 0);
const allocation = allocatedRows[0] || growerRows.find((row) => row.status === 'waiting') || null;
const tasks = model.tasks.filter((task) => task.growerId === grower.growerId);
const exceptions = model.exceptions.filter((item) => item.growerId === grower.growerId);
const transports = model.transports.filter((item) => item.growerId === grower.growerId);
const allocatedVolume = allocatedRows.reduce((sum, row) => sum + row.allocatedVolume, 0);
const availableVolume = growerLots.reduce((sum, lot) => sum + lot.availableVolume, 0);
const inBlueBand = Array.isArray(grower.supplierGroups) && grower.supplierGroups.includes('Blaues Band');
const cooperationLabel = inBlueBand ? 'Blaues Band' : 'Sonstiger Kooperationspartner';

const transportState = transports[0]?.state;
const transportLabel =
  transportState === 'document-ready' ? 'Begleitdokument vorbereitet' :
  transportState === 'prepared' ? 'Transport vorbereitet' :
  transportState === 'waiting-for-loading-data' ? 'Verladedaten fehlen' :
  'Noch kein Transport';

const profileStatus =
  exceptions.length > 0 ? 'Ausnahme prüfen' :
  tasks.length > 0 ? 'Winzer-Rückmeldung offen' :
  allocatedVolume > 0 ? 'Im Auftrag aktiv' :
  'Reserve / nicht zugeteilt';

const profileStatusClass =
  exceptions.length > 0 ? 'exception' :
  tasks.length > 0 ? 'waiting' :
  allocatedVolume > 0 ? 'ready' :
  'reserve';
---

<BaseLayout
  title={`${grower.growerName} · Winzerprofil`}
  description="Interne Test-Betriebsakte im Cockpit der Weinkommission Porn."
  canonicalPath={`/weinkommission/cockpit/winzer/${grower.growerId}/`}
>
  <div class="profile-app">
    <header class="profile-header">
      <div class="profile-header-inner">
        <a class="profile-back" href={`${base}cockpit/winzer/`}>← Winzerübersicht</a>
        <div class="profile-title">
          <p class="overline">Interne Betriebsakte · synthetischer Testdatensatz</p>
          <h1>{grower.growerName}</h1>
          <div class="profile-meta">
            <span>{grower.place}</span>
            <span>{cooperationLabel} · Testzuordnung</span>
            <span>{grower.growerId}</span>
          </div>
        </div>
        <div class="profile-actions">
          <span class:list={['profile-state', profileStatusClass]}>{profileStatus}</span>
          <a class="primary-button profile-invite-link" href={`${base}winzer/registrieren/?invite=${grower.growerId}`}>Zugang einladen</a>
          <button class="quiet-button" type="button" data-contact>Rückfrage anlegen</button>
        </div>
      </div>
    </header>

    <main class="profile-main" id="main">
      <section class="profile-command" aria-label="Winzer auf einen Blick">
        <div class="command-primary">
          <span class="overline">Heute relevant</span>
          <strong>{tasks.length + exceptions.length === 0 ? 'Kein Eingriff nötig' : `${tasks.length + exceptions.length} Punkt(e) offen`}</strong>
          <small>{tasks[0]?.task || exceptions[0]?.detail || 'Der Vorgang kann automatisch weiterlaufen.'}</small>
        </div>
        <div class="command-stat">
          <span>Verfügbar</span>
          <strong>{formatLiters(availableVolume)}</strong>
        </div>
        <div class="command-stat">
          <span>Zugeordnet</span>
          <strong>{formatLiters(allocatedVolume)}</strong>
        </div>
        <div class="command-stat">
          <span>Transport</span>
          <strong>{transportLabel}</strong>
        </div>
      </section>

      <nav class="profile-nav" aria-label="Betriebsakte">
        <a href="#aufgaben">Aufgaben</a>
        <a href="#partien">Partien</a>
        <a href="#transporte">Transporte</a>
        <a href="#stammdaten">Stammdaten</a>
        <a href="#portalprofil">Betriebsprofil</a>
        <a href="#historie">Historie</a>
      </nav>

      <section class="profile-section attention-section" id="aufgaben">
        <div class="section-heading profile-section-heading">
          <div>
            <p class="overline">Aufmerksamkeit</p>
            <h2>Was braucht Nadine hier?</h2>
          </div>
          <p>Nur offene Informationen oder echte Abweichungen erscheinen in diesem Bereich.</p>
        </div>

        <div class="attention-list">
          {tasks.length === 0 && exceptions.length === 0 ? (
            <article class="attention-item clear">
              <span class="attention-icon">✓</span>
              <div><strong>Keine offenen Aufgaben</strong><small>Alle aktuell benötigten Angaben sind vorhanden.</small></div>
              <em>automatisch</em>
            </article>
          ) : (
            <>
              {tasks.map((task) => (
                <article class="attention-item waiting">
                  <span class="attention-icon">↻</span>
                  <div><strong>{task.task}</strong><small>{task.lotId} · beim Winzer anzufragen bzw. zu bestätigen</small></div>
                  <em>Winzer</em>
                </article>
              ))}
              {exceptions.map((item) => (
                <article class="attention-item exception">
                  <span class="attention-icon">!</span>
                  <div><strong>Ausnahme prüfen</strong><small>{item.detail}</small></div>
                  <em>Nadine</em>
                </article>
              ))}
            </>
          )}
        </div>
      </section>

      <section class="profile-section" id="partien">
        <div class="section-heading profile-section-heading">
          <div><p class="overline">Partien</p><h2>{growerLots.length} aktuell hinterlegte Weinpartien</h2></div>
          <p>Partien sind vom Betrieb getrennt. Jede Partie kann unabhängig geprüft, zugeteilt, transportiert oder als Reserve geführt werden.</p>
        </div>

        <div class="lot-stack">
          {growerLots.map((lot) => {
            const row = growerRows.find(item => item.lotId === lot.lotId);
            return (
              <article class="lot-card">
                <div class="lot-card-head">
                  <div>
                    <span class="lot-code">{lot.lotId}</span>
                    <h3>{lot.vintage} {lot.grape} · {lot.origin}</h3>
                  </div>
                  <span class:list={['row-status', row?.status || 'reserve']}>{row?.label || 'ohne aktuellen Bedarf'}</span>
                </div>

                <div class="lot-metrics">
                  <div><span>Verfügbar</span><strong>{formatLiters(lot.availableVolume)}</strong></div>
                  <div><span>Zugeordnet</span><strong>{formatLiters(row?.allocatedVolume || 0)}</strong></div>
                  <div><span>Erzeugnis</span><strong>Wein</strong></div>
                  <div><span>Jahrgang</span><strong>{lot.vintage}</strong></div>
                </div>

                <div class="lot-checks">
                  <div class:list={{ok: lot.analysisConfirmed, open: !lot.analysisConfirmed}}>
                    <span>{lot.analysisConfirmed ? '✓' : '○'}</span><strong>Analytik</strong><small>{lot.analysisConfirmed ? 'bestätigt' : 'Bestätigung fehlt'}</small>
                  </div>
                  <div class:list={{ok: lot.treatmentsConfirmed, open: !lot.treatmentsConfirmed}}>
                    <span>{lot.treatmentsConfirmed ? '✓' : '○'}</span><strong>Behandlungen</strong><small>{lot.treatmentsConfirmed ? 'bestätigt' : 'Angabe fehlt'}</small>
                  </div>
                  <div class:list={{ok: lot.currentVolumeConfirmed, open: !lot.currentVolumeConfirmed}}>
                    <span>{lot.currentVolumeConfirmed ? '✓' : '○'}</span><strong>Menge</strong><small>{lot.currentVolumeConfirmed ? 'aktuell bestätigt' : 'erneut bestätigen'}</small>
                  </div>
                </div>

                <details class="lot-details">
                  <summary>Fachdaten anzeigen</summary>
                  <div class="detail-grid">
                    <div><span>Rebsorte</span><strong>{lot.grape}</strong></div>
                    <div><span>Herkunft</span><strong>{lot.origin}</strong></div>
                    <div><span>Produktart</span><strong>Wein</strong></div>
                    <div><span>Weinbauzone</span><strong>A</strong></div>
                    <div><span>Analysewerte</span><strong>{lot.analysisConfirmed ? 'im System bestätigt' : 'noch zu bestätigen'}</strong></div>
                    <div><span>Behandlungscodes</span><strong>{lot.treatmentsConfirmed ? 'im System bestätigt' : 'noch zu bestätigen'}</strong></div>
                  </div>
                </details>
              </article>
            );
          })}
        </div>
      </section>

      <section class="profile-section" id="transporte">
        <div class="section-heading profile-section-heading">
          <div><p class="overline">Transporte & Dokumente</p><h2>Aus der Zuteilung automatisch erzeugt.</h2></div>
          <p>Transport und Begleitdokument hängen an derselben Partie und übernehmen vorhandene Daten ohne erneute Eingabe.</p>
        </div>

        {transports.length > 0 ? (
          <div class="transport-stack">
            {transports.map((transport) => (
              <article class="transport-card">
                <div>
                  <span class="overline">Transport</span>
                  <strong>{transport.transportId}</strong>
                  <small>{transport.lotId} · {formatLiters(transport.volume)}</small>
                </div>
                <div>
                  <span>Status</span>
                  <strong>{transport.state === 'document-ready' ? 'Begleitdokument vorbereitet' : transport.state === 'prepared' ? 'Transport vorbereitet' : 'Verladedaten fehlen'}</strong>
                </div>
                <a href={`${base}cockpit/begleitdokument/`}>Vorgang öffnen →</a>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <strong>Noch kein Transport erzeugt.</strong>
            <p>Erst nach einer tatsächlichen Zuteilung wird aus der Partie automatisch ein Transportvorgang.</p>
          </div>
        )}
      </section>

      <section class="profile-section" id="stammdaten">
        <div class="section-heading profile-section-heading">
          <div><p class="overline">Stammdaten</p><h2>Einmal sauber erfassen.</h2></div>
          <p>Diese Angaben werden später aus Rolands/Nadines realem Bestand importiert und bei jedem Vorgang wiederverwendet.</p>
        </div>

        <div class="master-data">
          <div><span>Betrieb</span><strong>{grower.growerName}</strong></div>
          <div><span>Ort</span><strong>{grower.place}</strong></div>
          <div><span>Kooperation</span><strong>{cooperationLabel} · Testzuordnung</strong></div>
          <div class="missing"><span>Betriebsnummer</span><strong>noch nicht importiert</strong></div>
          <div class="missing"><span>Ansprechpartner</span><strong>noch nicht importiert</strong></div>
          <div class="missing"><span>Telefon</span><strong>noch nicht importiert</strong></div>
          <div class="missing"><span>E-Mail</span><strong>noch nicht importiert</strong></div>
          <div class="missing"><span>Verladeadresse</span><strong>noch nicht importiert</strong></div>
        </div>
      </section>

      <section class="profile-section portal-profile-section" id="portalprofil" data-portal-profile data-grower-id={grower.growerId} hidden>
        <div class="section-heading profile-section-heading">
          <div><p class="overline">Vom Winzer gepflegt</p><h2>Betriebsprofil</h2></div>
          <p>Diese dauerhaften Angaben stammen aus dem Winzerportal und helfen bei Matching, Mengenplanung und Logistik.</p>
        </div>

        <div class="portal-profile-summary">
          <div><span>Profilstatus</span><strong data-internal-completeness>—</strong></div>
          <div><span>Rebfläche</span><strong data-internal-hectares>—</strong></div>
          <div><span>Jahresproduktion</span><strong data-internal-production>—</strong></div>
          <div><span>Frei vermarktbar</span><strong data-internal-market-volume>—</strong></div>
          <div><span>Tank-/Lagerkapazität</span><strong data-internal-storage>—</strong></div>
          <div><span>Größter Tank</span><strong data-internal-largest-tank>—</strong></div>
        </div>

        <div class="portal-profile-detail">
          <article>
            <span>Rebsorten</span>
            <strong data-internal-grapes>—</strong>
          </article>
          <article>
            <span>Vermarktung</span>
            <strong data-internal-offers>—</strong>
          </article>
          <article>
            <span>Qualitätsstufen</span>
            <strong data-internal-qualities>—</strong>
          </article>
          <article>
            <span>Zertifizierungen</span>
            <strong data-internal-certifications>—</strong>
          </article>
          <article>
            <span>Typische Verladung</span>
            <strong data-internal-loading>—</strong>
          </article>
          <article>
            <span>Kontaktweg</span>
            <strong data-internal-contact>—</strong>
          </article>
        </div>
      </section>

      <section class="profile-section" id="historie">
        <div class="section-heading profile-section-heading">
          <div><p class="overline">Historie</p><h2>Eine nachvollziehbare Betriebsakte.</h2></div>
          <p>Produktiv entsteht diese Historie automatisch aus Angeboten, Rückmeldungen, Zuteilungen, Transporten und Dokumenten.</p>
        </div>

        <div class="timeline">
          <article><span>Heute</span><div><strong>Profil im Großbedarf bewertet</strong><small>Matching gegen {demoRequirement.id}</small></div></article>
          <article><span>Heute</span><div><strong>{growerLots.length} Partien im Bestand</strong><small>{allocation?.issue || 'Aktuelle Partien gegen Bedarfe bewertet'}</small></div></article>
          {allocatedVolume > 0 && <article><span>Heute</span><div><strong>{formatLiters(allocatedVolume)} reserviert</strong><small>für {demoRequirement.buyer}</small></div></article>}
          <article class="future"><span>Import</span><div><strong>Altdaten ergänzen</strong><small>frühere Geschäfte und Transporte werden beim Datenimport ergänzt</small></div></article>
        </div>
      </section>

      <section class="profile-footnote">
        <strong>Synthetische Test-Betriebsakte</strong>
        <p>Name, Mengen, Status und die derzeitige Zuordnung „{cooperationLabel}“ stammen ausschließlich aus dem Testbestand. Beim Import wird diese Testakte vollständig durch den realen Partnerdatensatz einschließlich tatsächlicher Blaues-Band-Zugehörigkeit ersetzt.</p>
      </section>

      <dialog class="profile-dialog" data-contact-dialog>
        <button class="dialog-close" type="button" data-close-contact aria-label="Schließen">×</button>
        <p class="overline">Rückfrage · Demo</p>
        <h2>Aufgabe für {grower.growerName}</h2>
        <p>Produktiv kann Nadine hier gezielt eine fehlende Information anfordern. Das System erzeugt daraus automatisch die passende Winzer-Aufgabe und verfolgt den Status.</p>
        <div class="dialog-task">
          <span>Vorschlag</span>
          <strong>{tasks[0]?.task || 'Partiedaten bestätigen'}</strong>
        </div>
        <button class="primary-button" type="button" data-close-contact>Schließen</button>
      </dialog>
    </main>
  </div>

  <script>
    const dialog = document.querySelector('[data-contact-dialog]');
    document.querySelector('[data-contact]').addEventListener('click', () => dialog.showModal());
    document.querySelectorAll('[data-close-contact]').forEach(button => button.addEventListener('click', () => dialog.close()));

    const portalProfile = JSON.parse(localStorage.getItem('wp-demo-grower-profile') || 'null');
    const profileSection = document.querySelector('[data-portal-profile]');
    if (portalProfile && profileSection && portalProfile.growerId === profileSection.dataset.growerId) {
      profileSection.hidden = false;
      const set = (selector, value) => {
        const el = document.querySelector(selector);
        if (el) el.textContent = value || '—';
      };
      set('[data-internal-completeness]', (portalProfile.completeness || 0) + ' %');
      set('[data-internal-hectares]', portalProfile.hectares);
      set('[data-internal-production]', portalProfile.annualProduction);
      set('[data-internal-market-volume]', portalProfile.marketVolume);
      set('[data-internal-storage]', portalProfile.storage);
      set('[data-internal-largest-tank]', portalProfile.largestTank);
      set('[data-internal-grapes]', (portalProfile.grapes || []).join(', '));
      set('[data-internal-offers]', (portalProfile.offers || []).join(', '));
      set('[data-internal-qualities]', (portalProfile.qualities || []).join(', '));
      set('[data-internal-certifications]', (portalProfile.certifications || []).join(', '));
      set('[data-internal-loading]', portalProfile.loadingVolume);
      set('[data-internal-contact]', portalProfile.preferredContact === 'phone' ? 'Telefon' : portalProfile.preferredContact === 'mobile' ? 'Mobil / Messenger' : 'E-Mail');
    }
  </script>
</BaseLayout>
