---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/registrieren.css';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Winzerzugang · Weinkommission Porn"
  description="Demo für Einladung, Registrierung und Kooperationsanfrage im Winzerportal."
  canonicalPath="/weinkommission/winzer/registrieren/"
>
  <div class="onboarding-app">
    <header class="onboarding-header">
      <a class="onboarding-brand" href={`${base}winzer/`}>
        <span class="brand-mark">WP</span>
        <span><strong>WEINKOMMISSION PORN</strong><small>Winzerzugang · Demo</small></span>
      </a>
      <span class="demo-label">Demo · keine Nachrichten werden versendet</span>
    </header>

    <main class="onboarding-main">
      <section class="onboarding-intro" data-landing>
        <p class="eyebrow">Digital zusammenarbeiten</p>
        <h1>Ihr Zugang zur<br />Weinkommission.</h1>
        <p>Bestehende Partner aktivieren ihren Zugang über eine persönliche Einladung. Neue Betriebe können eine Zusammenarbeit anfragen.</p>

        <div class="entry-options">
          <button class="entry-card invited" type="button" data-start-invite>
            <span class="entry-kicker">Bereits Partner?</span>
            <strong>Einladung verwenden</strong>
            <p>Bestehende Betriebsakte verbinden, Daten prüfen und Zugang aktivieren.</p>
            <em>Weiter →</em>
          </button>
          <button class="entry-card new" type="button" data-start-request>
            <span class="entry-kicker">Noch kein Partner?</span>
            <strong>Zusammenarbeit anfragen</strong>
            <p>Nur die wichtigsten Angaben senden. Nadine oder Roland prüfen die Anfrage.</p>
            <em>Anfrage starten →</em>
          </button>
        </div>

        <div class="demo-shortcut">
          <div>
            <strong>Demo-Einladung testen</strong>
            <small>Öffnet einen bereits bekannten Testbetrieb.</small>
          </div>
          <a href={`${base}winzer/registrieren/?invite=TEST-001`}>TEST-001 öffnen →</a>
        </div>
      </section>

      <section class="flow-shell" data-invite-flow hidden>
        <div class="flow-top">
          <button class="back-link" type="button" data-flow-home>← Zur Auswahl</button>
          <span class="flow-type">Einladung · bestehender Partner</span>
        </div>

        <div class="progress" aria-label="Fortschritt">
          <span class="active" data-progress="1">1</span><i></i>
          <span data-progress="2">2</span><i></i>
          <span data-progress="3">3</span><i></i>
          <span data-progress="4">4</span>
        </div>

        <article class="flow-step" data-invite-step="1">
          <p class="eyebrow">Schritt 1 · Einladung</p>
          <h2>Betrieb gefunden.</h2>
          <p class="step-copy">Die Einladung verweist auf eine bereits vorhandene interne Betriebsakte. Es wird kein zweiter Winzerdatensatz angelegt.</p>

          <div class="matched-business">
            <span class="match-check">✓</span>
            <div>
              <strong data-invite-name>Weingut Ahrensberg & Sohn</strong>
              <small><span data-invite-place>Bernkastel-Kues</span> · <span data-invite-id>TEST-001</span></small>
            </div>
            <em data-invite-group>Blaues Band · Testzuordnung</em>
          </div>

          <label class="field">
            <span>Einladungscode oder Link</span>
            <input data-invite-code value="TEST-001" autocomplete="off" />
            <small>In der Live-Version ist der Link signiert, zeitlich begrenzt und nur einmal verwendbar.</small>
          </label>

          <button class="primary-action" type="button" data-invite-next="2">Betrieb bestätigen →</button>
        </article>

        <article class="flow-step" data-invite-step="2" hidden>
          <p class="eyebrow">Schritt 2 · Identität</p>
          <h2>Wie sollen wir Sie bestätigen?</h2>
          <p class="step-copy">Für die Demo wird keine echte SMS oder E-Mail verschickt. Im Live-System dient dieser Schritt der Identitätsbestätigung.</p>

          <div class="contact-choice">
            <label>
              <input type="radio" name="verify-channel" value="email" checked />
              <span><strong>E-Mail</strong><small>Magic Link oder Einmalcode</small></span>
            </label>
            <label>
              <input type="radio" name="verify-channel" value="mobile" />
              <span><strong>Mobilnummer</strong><small>Einmalcode per SMS</small></span>
            </label>
          </div>

          <label class="field">
            <span>E-Mail oder Mobilnummer</span>
            <input data-identity-contact placeholder="z. B. name@weingut.de" autocomplete="email" />
          </label>

          <div class="demo-code">
            <div><span>Demo-Code</span><strong>642731</strong></div>
            <button type="button" data-use-code>Code übernehmen</button>
          </div>

          <label class="field">
            <span>Bestätigungscode</span>
            <input data-verification-code inputmode="numeric" maxlength="6" placeholder="6-stelliger Code" />
          </label>

          <p class="form-error" data-verify-error hidden>Für die Demo bitte Kontakt angeben und den Code 642731 verwenden.</p>
          <button class="primary-action" type="button" data-verify>Identität bestätigen →</button>
        </article>

        <article class="flow-step" data-invite-step="3" hidden>
          <p class="eyebrow">Schritt 3 · Betriebsdaten</p>
          <h2>Einmal prüfen.</h2>
          <p class="step-copy">Bekannte Daten werden übernommen. Der Winzer bestätigt oder korrigiert nur, was tatsächlich geändert werden muss.</p>

          <div class="review-grid">
            <label class="field"><span>Betrieb</span><input data-review-name /></label>
            <label class="field"><span>Ort</span><input data-review-place /></label>
            <label class="field"><span>Betriebsnummer</span><input data-review-number placeholder="noch nicht importiert" /></label>
            <label class="field"><span>Ansprechpartner</span><input data-review-contact placeholder="Ansprechpartner ergänzen" /></label>
          </div>

          <label class="membership-claim">
            <input type="checkbox" data-blueband-claim />
            <span><strong>Unser Betrieb gehört zum Blauen Band.</strong><small>Diese Angabe wird im Cockpit als „vom Winzer angegeben“ gespeichert und von Nadine/Roland bestätigt.</small></span>
          </label>

          <label class="confirm-line">
            <input type="checkbox" data-review-confirm />
            <span>Ich bestätige, dass die Angaben für unseren Betrieb korrekt sind.</span>
          </label>

          <p class="form-error" data-review-error hidden>Bitte die Betriebsdaten bestätigen.</p>
          <button class="primary-action" type="button" data-activate>Zugang aktivieren →</button>
        </article>

        <article class="flow-step success-step" data-invite-step="4" hidden>
          <span class="success-mark">✓</span>
          <p class="eyebrow">Demo erfolgreich</p>
          <h2>Zugang aktiviert.</h2>
          <p>Der Portalzugang ist jetzt mit der vorhandenen Betriebsakte <strong data-success-business></strong> verknüpft. Im Live-System würde ab hier eine echte Auth-Session entstehen.</p>

          <div class="success-summary">
            <div><span>Status</span><strong>Aktiv</strong></div>
            <div><span>Betriebsakte</span><strong data-success-id>TEST-001</strong></div>
            <div><span>Zugang</span><strong>mit Bestand verknüpft</strong></div>
          </div>

          <a class="primary-action link-action" href={`${base}winzer/profil/`}>Betriebsprofil vervollständigen →</a>
          <a class="secondary-action link-action" href={`${base}winzer/`}>Später zum Winzerportal</a>
          <button class="secondary-action" type="button" data-reset-demo>Demo zurücksetzen</button>
        </article>
      </section>

      <section class="flow-shell" data-request-flow hidden>
        <div class="flow-top">
          <button class="back-link" type="button" data-flow-home>← Zur Auswahl</button>
          <span class="flow-type">Neue Kooperationsanfrage</span>
        </div>

        <article class="request-form" data-request-form>
          <div class="request-progress">
            <span class="active" data-request-progress="1">1 · Betrieb & Kontakt</span>
            <span data-request-progress="2">2 · Weinbauprofil</span>
          </div>

          <div data-request-step="1">
            <p class="eyebrow">Neue Zusammenarbeit · Schritt 1</p>
            <h2>Wer sind Sie?</h2>
            <p class="step-copy">Damit Nadine oder Roland den Betrieb eindeutig zuordnen und Rückfragen direkt an die richtige Person richten können.</p>

            <div class="review-grid">
              <label class="field"><span>Weingut / Betrieb *</span><input data-request-business required autocomplete="organization" /></label>
              <label class="field"><span>Ansprechpartner *</span><input data-request-person required autocomplete="name" /></label>
              <label class="field field-wide"><span>Straße & Hausnummer *</span><input data-request-street required autocomplete="street-address" /></label>
              <label class="field"><span>PLZ *</span><input data-request-postcode required inputmode="numeric" autocomplete="postal-code" /></label>
              <label class="field"><span>Ort *</span><input data-request-place required autocomplete="address-level2" /></label>
              <label class="field"><span>E-Mail *</span><input type="email" data-request-email required autocomplete="email" /></label>
              <label class="field"><span>Telefon / Mobil *</span><input type="tel" data-request-phone required autocomplete="tel" /></label>
              <label class="field"><span>Weinbau-Betriebsnummer</span><input data-request-number placeholder="falls vorhanden / bekannt" /></label>
              <label class="field"><span>Webseite, falls vorhanden</span><input type="url" data-request-website placeholder="https://…" /></label>
            </div>

            <p class="form-error" data-request-step1-error hidden>Bitte die mit * markierten Angaben vollständig ausfüllen.</p>
            <div class="demo-form-actions">
              <button class="secondary-action" type="button" data-fill-request-demo>Demo-Daten einsetzen</button>
              <button class="primary-action" type="button" data-request-next>Weiter zum Weinbauprofil →</button>
            </div>
          </div>

          <div data-request-step="2" hidden>
            <button class="back-button request-back" type="button" data-request-back>← Betrieb & Kontakt</button>
            <p class="eyebrow">Neue Zusammenarbeit · Schritt 2</p>
            <h2>Was können Sie anbieten?</h2>
            <p class="step-copy">Noch keine vollständige Partiemeldung – nur ein Profil, mit dem die Weinkommission den Betrieb sinnvoll einordnen und später passende Bedarfe zuordnen kann.</p>

            <div class="review-grid">
              <label class="field">
                <span>Anbaugebiet *</span>
                <select data-request-region>
                  <option value="Mosel" selected>Mosel</option>
                  <option value="Saar">Saar</option>
                  <option value="Ruwer">Ruwer</option>
                  <option value="Ahr">Ahr</option>
                  <option value="Nahe">Nahe</option>
                  <option value="Rheinhessen">Rheinhessen</option>
                  <option value="Pfalz">Pfalz</option>
                  <option value="Sonstiges">Sonstiges</option>
                </select>
              </label>
              <label class="field"><span>Rebfläche ungefähr</span><input data-request-hectares inputmode="decimal" placeholder="z. B. 12,5 ha" /></label>
              <label class="field"><span>Typische verfügbare Menge / Jahr</span><input data-request-volume inputmode="numeric" placeholder="z. B. 120.000 l" /></label>
              <label class="field"><span>Bevorzugter Kontaktweg</span>
                <select data-request-preferred-contact>
                  <option value="email">E-Mail</option>
                  <option value="phone">Telefon</option>
                  <option value="mobile">Mobil / Messenger</option>
                </select>
              </label>
            </div>

            <fieldset class="profile-choice">
              <legend>Wichtigste Rebsorten</legend>
              <div class="choice-grid">
                <label><input type="checkbox" value="Riesling" data-request-grape /><span>Riesling</span></label>
                <label><input type="checkbox" value="Müller-Thurgau" data-request-grape /><span>Müller-Thurgau</span></label>
                <label><input type="checkbox" value="Weißburgunder" data-request-grape /><span>Weißburgunder</span></label>
                <label><input type="checkbox" value="Grauburgunder" data-request-grape /><span>Grauburgunder</span></label>
                <label><input type="checkbox" value="Spätburgunder" data-request-grape /><span>Spätburgunder</span></label>
                <label><input type="checkbox" value="Sonstige" data-request-grape /><span>Sonstige</span></label>
              </div>
            </fieldset>

            <fieldset class="profile-choice">
              <legend>Was möchten Sie über die Weinkommission anbieten?</legend>
              <div class="choice-grid">
                <label><input type="checkbox" value="Fasswein" data-request-offer /><span>Fasswein</span></label>
                <label><input type="checkbox" value="Most" data-request-offer /><span>Most</span></label>
                <label><input type="checkbox" value="Trauben" data-request-offer /><span>Trauben</span></label>
                <label><input type="checkbox" value="Sonstiges" data-request-offer /><span>Sonstiges</span></label>
              </div>
            </fieldset>

            <label class="field">
              <span>Kurze Ergänzung / Besonderheiten</span>
              <textarea data-request-note rows="4" placeholder="z. B. verfügbare Jahrgänge, besondere Mengen, Bio-Zertifizierung, aktuelle Partien …"></textarea>
            </label>

            <label class="membership-claim">
              <input type="checkbox" data-request-blueband />
              <span><strong>Wir gehören zum Blauen Band.</strong><small>Die Zugehörigkeit wird erst nach interner Bestätigung als verifiziert geführt.</small></span>
            </label>

            <label class="confirm-line">
              <input type="checkbox" data-request-consent />
              <span>Ich bestätige, dass die Angaben korrekt sind und die Weinkommission mich dazu kontaktieren darf.</span>
            </label>

            <p class="form-error" data-request-error hidden>Bitte mindestens eine Rebsorte oder Angebotsart auswählen und die Angaben bestätigen.</p>
            <div class="demo-form-actions">
              <button class="secondary-action" type="button" data-fill-profile-demo>Demo-Profil einsetzen</button>
              <button class="primary-action" type="button" data-submit-request>Anfrage senden →</button>
            </div>
          </div>
        </article>

        <article class="success-step request-success" data-request-success hidden>
          <span class="success-mark">✓</span>
          <p class="eyebrow">Anfrage eingegangen</p>
          <h2>Jetzt prüft die Weinkommission.</h2>
          <p>Der Betrieb wurde im Demo-Workflow mit Status <strong>„Prüfung erforderlich“</strong> angelegt. Es besteht noch kein aktiver Zugang.</p>

          <div class="success-summary">
            <div><span>Status</span><strong>Prüfung erforderlich</strong></div>
            <div><span>Blaues Band</span><strong data-request-membership>nicht angegeben</strong></div>
            <div><span>Nächster Schritt</span><strong>Nadine/Roland prüfen</strong></div>
          </div>

          <button class="secondary-action" type="button" data-reset-demo>Neue Demo starten</button>
        </article>
      </section>
    </main>
  </div>

  <script>
    import { demoGrowers } from '../../data/procurement-demo.js';

    const landing = document.querySelector('[data-landing]');
    const inviteFlow = document.querySelector('[data-invite-flow]');
    const requestFlow = document.querySelector('[data-request-flow]');
    let currentGrower = null;

    function showLanding() {
      landing.hidden = false;
      inviteFlow.hidden = true;
      requestFlow.hidden = true;
      history.replaceState({}, '', location.pathname);
    }

    function setInviteStep(step) {
      document.querySelectorAll('[data-invite-step]').forEach(el => {
        el.hidden = el.dataset.inviteStep !== String(step);
      });
      document.querySelectorAll('[data-progress]').forEach(el => {
        el.classList.toggle('active', Number(el.dataset.progress) <= step);
      });
    }

    function loadInvite(id) {
      currentGrower = demoGrowers.find(g => g.growerId === id) || demoGrowers[0];
      landing.hidden = true;
      requestFlow.hidden = true;
      inviteFlow.hidden = false;

      document.querySelector('[data-invite-name]').textContent = currentGrower.growerName;
      document.querySelector('[data-invite-place]').textContent = currentGrower.place;
      document.querySelector('[data-invite-id]').textContent = currentGrower.growerId;
      document.querySelector('[data-invite-code]').value = currentGrower.growerId;
      document.querySelector('[data-invite-group]').textContent = currentGrower.supplierGroups.includes('Blaues Band')
        ? 'Blaues Band · Testzuordnung'
        : 'Sonstiger Partner · Testzuordnung';
      document.querySelector('[data-review-name]').value = currentGrower.growerName;
      document.querySelector('[data-review-place]').value = currentGrower.place;
      document.querySelector('[data-blueband-claim]').checked = currentGrower.supplierGroups.includes('Blaues Band');
      setInviteStep(1);
    }

    function startRequest() {
      landing.hidden = true;
      inviteFlow.hidden = true;
      requestFlow.hidden = false;
      document.querySelector('[data-request-form]').hidden = false;
      document.querySelector('[data-request-success]').hidden = true;
      if (typeof setRequestStep === 'function') setRequestStep(1);
    }

    document.querySelector('[data-start-invite]').addEventListener('click', () => loadInvite('TEST-001'));
    document.querySelector('[data-start-request]').addEventListener('click', startRequest);
    document.querySelectorAll('[data-flow-home]').forEach(button => button.addEventListener('click', showLanding));

    document.querySelector('[data-invite-next]').addEventListener('click', () => {
      const code = document.querySelector('[data-invite-code]').value.trim();
      const found = demoGrowers.find(g => g.growerId === code);
      if (found) loadInvite(found.growerId);
      setInviteStep(2);
    });

    document.querySelector('[data-use-code]').addEventListener('click', () => {
      document.querySelector('[data-verification-code]').value = '642731';
    });

    document.querySelector('[data-verify]').addEventListener('click', () => {
      const contact = document.querySelector('[data-identity-contact]').value.trim();
      const code = document.querySelector('[data-verification-code]').value.trim();
      const error = document.querySelector('[data-verify-error]');
      if (!contact || code !== '642731') {
        error.hidden = false;
        return;
      }
      error.hidden = true;
      setInviteStep(3);
    });

    document.querySelector('[data-activate]').addEventListener('click', () => {
      const confirmed = document.querySelector('[data-review-confirm]').checked;
      const error = document.querySelector('[data-review-error]');
      if (!confirmed) {
        error.hidden = false;
        return;
      }
      error.hidden = true;

      const account = {
        growerId: currentGrower.growerId,
        businessName: document.querySelector('[data-review-name]').value.trim(),
        place: document.querySelector('[data-review-place]').value.trim(),
        businessNumber: document.querySelector('[data-review-number]').value.trim(),
        contactPerson: document.querySelector('[data-review-contact]').value.trim(),
        blueBandClaimed: document.querySelector('[data-blueband-claim]').checked,
        status: 'active',
        linkedExistingRecord: true,
        demo: true
      };
      localStorage.setItem('wp-demo-grower-account', JSON.stringify(account));
      document.querySelector('[data-success-business]').textContent = account.businessName;
      document.querySelector('[data-success-id]').textContent = account.growerId;
      setInviteStep(4);
    });

    const requestStep1 = document.querySelector('[data-request-step="1"]');
    const requestStep2 = document.querySelector('[data-request-step="2"]');

    function setRequestStep(step) {
      requestStep1.hidden = step !== 1;
      requestStep2.hidden = step !== 2;
      document.querySelectorAll('[data-request-progress]').forEach(el => {
        el.classList.toggle('active', Number(el.dataset.requestProgress) <= step);
      });
    }

    document.querySelector('[data-fill-request-demo]').addEventListener('click', () => {
      document.querySelector('[data-request-business]').value = 'Weingut Demo';
      document.querySelector('[data-request-person]').value = 'Max Mustermann';
      document.querySelector('[data-request-street]').value = 'Moselstraße 12';
      document.querySelector('[data-request-postcode]').value = '54470';
      document.querySelector('[data-request-place]').value = 'Bernkastel-Kues';
      document.querySelector('[data-request-email]').value = 'demo@weingut.de';
      document.querySelector('[data-request-phone]').value = '06531 123456';
      document.querySelector('[data-request-number]').value = 'DEMO-12345';
      document.querySelector('[data-request-website]').value = 'https://example.com';
    });

    document.querySelector('[data-fill-profile-demo]').addEventListener('click', () => {
      document.querySelector('[data-request-region]').value = 'Mosel';
      document.querySelector('[data-request-hectares]').value = '12,5 ha';
      document.querySelector('[data-request-volume]').value = '120.000 l';
      document.querySelector('[data-request-preferred-contact]').value = 'email';
      document.querySelectorAll('[data-request-grape]').forEach(el => el.checked = false);
      document.querySelectorAll('[data-request-offer]').forEach(el => el.checked = false);
      const riesling = [...document.querySelectorAll('[data-request-grape]')].find(el => el.value === 'Riesling');
      const fasswein = [...document.querySelectorAll('[data-request-offer]')].find(el => el.value === 'Fasswein');
      if (riesling) riesling.checked = true;
      if (fasswein) fasswein.checked = true;
      document.querySelector('[data-request-note]').value = 'Demo-Profil für die Präsentation.';
      document.querySelector('[data-request-consent]').checked = true;
    });

    document.querySelector('[data-request-next]').addEventListener('click', () => {
      const required = [
        document.querySelector('[data-request-business]').value.trim(),
        document.querySelector('[data-request-person]').value.trim(),
        document.querySelector('[data-request-street]').value.trim(),
        document.querySelector('[data-request-postcode]').value.trim(),
        document.querySelector('[data-request-place]').value.trim(),
        document.querySelector('[data-request-email]').value.trim(),
        document.querySelector('[data-request-phone]').value.trim()
      ];
      const error = document.querySelector('[data-request-step1-error]');
      if (required.some(value => !value)) {
        error.hidden = false;
        return;
      }
      error.hidden = true;
      setRequestStep(2);
    });

    document.querySelector('[data-request-back]').addEventListener('click', () => setRequestStep(1));

    document.querySelector('[data-submit-request]').addEventListener('click', () => {
      const grapes = [...document.querySelectorAll('[data-request-grape]:checked')].map(el => el.value);
      const offers = [...document.querySelectorAll('[data-request-offer]:checked')].map(el => el.value);

      const values = {
        businessName: document.querySelector('[data-request-business]').value.trim(),
        person: document.querySelector('[data-request-person]').value.trim(),
        street: document.querySelector('[data-request-street]').value.trim(),
        postcode: document.querySelector('[data-request-postcode]').value.trim(),
        place: document.querySelector('[data-request-place]').value.trim(),
        email: document.querySelector('[data-request-email]').value.trim(),
        phone: document.querySelector('[data-request-phone]').value.trim(),
        contact: document.querySelector('[data-request-email]').value.trim() || document.querySelector('[data-request-phone]').value.trim(),
        businessNumber: document.querySelector('[data-request-number]').value.trim(),
        website: document.querySelector('[data-request-website]').value.trim(),
        region: document.querySelector('[data-request-region]').value,
        hectares: document.querySelector('[data-request-hectares]').value.trim(),
        typicalAnnualVolume: document.querySelector('[data-request-volume]').value.trim(),
        preferredContact: document.querySelector('[data-request-preferred-contact]').value,
        grapes,
        offers,
        note: document.querySelector('[data-request-note]').value.trim(),
        blueBandClaimed: document.querySelector('[data-request-blueband]').checked,
        consent: document.querySelector('[data-request-consent]').checked
      };

      const error = document.querySelector('[data-request-error]');
      if ((grapes.length === 0 && offers.length === 0) || !values.consent) {
        error.hidden = false;
        return;
      }
      error.hidden = true;

      const request = {
        id: 'REQ-' + Date.now(),
        ...values,
        status: 'review_required',
        createdAt: new Date().toISOString(),
        demo: true
      };
      const requests = JSON.parse(localStorage.getItem('wp-demo-registration-requests') || '[]');
      requests.unshift(request);
      localStorage.setItem('wp-demo-registration-requests', JSON.stringify(requests.slice(0, 10)));

      document.querySelector('[data-request-form]').hidden = true;
      document.querySelector('[data-request-success]').hidden = false;
      document.querySelector('[data-request-membership]').textContent = values.blueBandClaimed
        ? 'angegeben · unbestätigt'
        : 'nicht angegeben';
    });

    document.querySelectorAll('[data-reset-demo]').forEach(button => button.addEventListener('click', () => {
      localStorage.removeItem('wp-demo-grower-account');
      showLanding();
      location.reload();
    }));

    const inviteId = new URLSearchParams(location.search).get('invite');
    if (inviteId) loadInvite(inviteId);
  </script>
</BaseLayout>
