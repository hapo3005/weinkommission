---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/demo-hub.css';
import { demoGrowers, demoRequirement, demoProcurementRows } from '../data/procurement-demo.js';
import { runProcurement } from '../lib/procurementEngine.js';

const base = import.meta.env.BASE_URL;
const model = runProcurement(demoRequirement, demoProcurementRows);

const scenarioCandidates = [
  { key:'waiting', label:'Rückmeldung fehlt', row:model.allocationRows.find(row => row.status === 'waiting'), note:'Winzer muss fehlende Partiedaten bestätigen.' },
  { key:'transport', label:'Transportdaten fehlen', row:model.allocationRows.find(row => row.status === 'transport'), note:'Zuteilung steht, Verladung muss ergänzt werden.' },
  { key:'document', label:'Dokument vorbereitet', row:model.allocationRows.find(row => row.status === 'document'), note:'Prozess ist bis zum Dokumentstatus fortgeschritten.' },
  { key:'ready', label:'Läuft ohne Eingriff', row:model.allocationRows.find(row => row.status === 'ready'), note:'Keine Rückmeldung nötig; Routine läuft weiter.' },
  { key:'reserve', label:'Reserve / nicht zugeteilt', row:model.allocationRows.find(row => row.status === 'reserve'), note:'Passende Partie, aktuell aber nicht benötigt.' },
  { key:'profile', label:'Profil unvollständig', grower:demoGrowers.find(g => g.profile.completeness < 100), note:'Betriebsprofil braucht Ergänzungen.' },
  { key:'other', label:'Kein Blaues Band', grower:demoGrowers.find(g => !g.supplierGroups.includes('Blaues Band')), note:'Kooperationspartner außerhalb des aktuellen Verbund-Scope.' }
];

const scenarios = scenarioCandidates.map(item => {
  const grower = item.grower || demoGrowers.find(g => g.growerId === item.row?.growerId);
  return grower ? {...item, grower} : null;
}).filter(Boolean);
---

<BaseLayout
  title="Demo-Zentrale · Weinkommission Porn"
  description="Klare Auswahl der Demo-Perspektiven."
  canonicalPath="/weinkommission/demo/"
>
  <main class="demo-hub">
    <header class="demo-hub-head">
      <p>WEINKOMMISSION PORN · DEMO-ZENTRALE</p>
      <h1>Welche Perspektive möchtest du sehen?</h1>
      <span>Die Rollen sind bewusst getrennt. Keine Oberfläche zeigt Funktionen einer anderen Rolle.</span>
    </header>

    <section class="demo-presenter">
      <div class="demo-presenter-head">
        <div>
          <p>Pitch-Modus · Demobetriebe</p>
          <h2>Jeden Betrieb und jeden Problemfall live öffnen.</h2>
        </div>
        <span>{demoGrowers.length} vollständige synthetische Betriebsakten</span>
      </div>

      <div class="demo-grower-picker">
        <label>
          <span>Demobetrieb auswählen</span>
          <select data-demo-grower-select>
            {demoGrowers.map(grower => (
              <option value={grower.growerId}>{grower.growerName} · {grower.place} · {grower.growerId}</option>
            ))}
          </select>
        </label>
        <button type="button" data-open-grower>Als Winzer öffnen →</button>
        <button type="button" class="internal-button" data-open-internal>Interne Betriebsakte →</button>
      </div>

      <div class="demo-scenarios">
        {scenarios.map(scenario => (
          <a href={`${base}winzer/?grower=${scenario.grower.growerId}`}>
            <span>{scenario.label}</span>
            <strong>{scenario.grower.growerName}</strong>
            <small>{scenario.note}</small>
            <em>{scenario.grower.growerId} →</em>
          </a>
        ))}
      </div>
    </section>

    <section class="demo-role-grid">
      <a class="demo-role internal" href={`${base}cockpit/`}>
        <span class="role-kicker">Interne Verwaltung</span>
        <h2>Nadine / Roland</h2>
        <p>Gesamter Überblick über Winzer, Großbedarfe, Zuteilungen, Transporte, Begleitdokumente und offene Aufgaben.</p>
        <div>
          <span>Sie sehen alle kooperierenden Betriebe</span>
          <span>Sie sehen Ausnahmen und offene Rückmeldungen</span>
          <span>Sie steuern und kontrollieren die Prozesse</span>
        </div>
        <strong>Interne Oberfläche öffnen →</strong>
      </a>

      <a class="demo-role grower" href={`${base}winzer/`}>
        <span class="role-kicker">Externe Ansicht</span>
        <h2>Winzer</h2>
        <p>Der einzelne Winzer sieht ausschließlich seinen eigenen Betrieb, seine Partien, Aufgaben und das eigene Betriebsprofil.</p>
        <div>
          <span>Keine anderen Winzer sichtbar</span>
          <span>Keine internen Kommissionsdaten sichtbar</span>
          <span>Nur eigene Angaben und Rückmeldungen</span>
        </div>
        <strong>Winzerportal öffnen →</strong>
      </a>

      <a class="demo-role buyer" href={`${base}abnehmer/`}>
        <span class="role-kicker">Externe Ansicht</span>
        <h2>Abnehmer / Kellerei</h2>
        <p>Die Kellerei meldet eigene Bedarfe und verfolgt den Lieferstand, ohne Winzerakten oder interne Kommissionsabläufe zu sehen.</p>
        <div>
          <span>Eigene Bedarfe einstellen</span>
          <span>Deckung und Lieferstatus verfolgen</span>
          <span>Keine internen Winzerdaten sichtbar</span>
        </div>
        <strong>Abnehmerportal öffnen →</strong>
      </a>

      <a class="demo-role driver" href={`${base}fahrer/`}>
        <span class="role-kicker">Externe Ansicht</span>
        <h2>Spedition / Fahrer</h2>
        <p>Der Fahrer sieht ausschließlich die zugewiesenen Abholungen und bestätigt die tatsächlich verladenen Daten.</p>
        <div>
          <span>Nur eigene Touren sichtbar</span>
          <span>Liter, Kennzeichen und Abholung bestätigen</span>
          <span>Keine Einkaufs- oder Winzerkartei sichtbar</span>
        </div>
        <strong>Transportportal öffnen →</strong>
      </a>
    </section>

    <section class="demo-public">
      <div>
        <span>Öffentliche Website</span>
        <strong>Für Interessenten, Partner und Besucher</strong>
        <small>Keine internen Daten, keine Winzerakten, keine Arbeitsprozesse.</small>
      </div>
      <a href={base}>Öffentliche Website öffnen →</a>
    </section>

    <section class="demo-map">
      <p>So ist das System jetzt gedacht</p>
      <div class="map-flow">
        <span>Öffentliche Website</span><i>→</i>
        <span>Nadine / Roland intern</span><i>↔</i>
        <span>Zentrale Daten & Prozesse</span><i>↔</i>
        <span>Winzer</span>
        <span>Abnehmer / Kellerei</span>
        <span>Spedition / Fahrer</span>
      </div>
    </section>
  </main>

  <script>
    const select = document.querySelector('[data-demo-grower-select]');
    const basePath = import.meta.env.BASE_URL;
    document.querySelector('[data-open-grower]').addEventListener('click', () => {
      location.href = basePath + 'winzer/?grower=' + encodeURIComponent(select.value);
    });
    document.querySelector('[data-open-internal]').addEventListener('click', () => {
      location.href = basePath + 'cockpit/winzer/' + encodeURIComponent(select.value) + '/';
    });
  </script>
</BaseLayout>
