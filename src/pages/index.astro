            <g class="instrument-stations">
              <g transform="translate(145 518)"><circle r="5"/><text x="14" y="4">TRIER</text></g>
              <g transform="translate(329 315)"><circle r="5"/><text x="14" y="4">BERNKASTEL-KUES</text></g>
              <g transform="translate(444 198)"><circle r="5"/><text x="14" y="4">ZELL</text></g>
              <g transform="translate(568 94)"><circle r="5"/><text x="14" y="4">COCHEM</text></g>
              <g transform="translate(694 28)"><circle r="5"/><text x="-14" y="-13" text-anchor="end">KOBLENZ</text></g>
            </g>

            <g class="instrument-notes" aria-hidden="true">
              <text x="38" y="42">HERKUNFT / NETZWERK</text>
              <text x="38" y="60">MOSEL · RHEINLAND-PFALZ</text>
              <text x="604" y="556">MARKTZUGANG</text>
              <path d="M604 572H716" />
              <path d="M706 564L716 572L706 580" />
            </g>
          </svg>

          <div class="instrument-reach">
            <span class="reach-label">Marktreichweite</span>
            <div class="reach-track" aria-label="Mosel, Deutschland, Europa, international">
              <span>Mosel</span><i></i><span>DE</span><i></i><span>EU</span><i></i><span>International</span>
            </div>
          </div>
        </div>
      </div>

      <div class="shell hero-index" aria-hidden="true">
        <span>01 · Herkunft</span>
        <span>02 · Vermittlung</span>
        <span>03 · Markt</span>
      </div>
    </section>

    <section class="section profile" id="profil" aria-labelledby="profil-title">
      <div class="shell split">
        <div><p class="eyebrow">01 · Profil</p><h2 id="profil-title">Zwischen Wein und Markt braucht es Menschen, die beides verstehen.</h2></div>
