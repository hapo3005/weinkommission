---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/final-home.css';

---

<BaseLayout
  title="Weinkommission Porn · Mosel | Persönliche Weinvermittlung"
  description="Weinkommission Porn an der Mosel – persönliche Weinvermittlung zwischen Erzeugern und professionellen Abnehmern."
>
  <header class="site-header">
    <div class="shell header-row">
      <a class="brand" href="#top" aria-label="Weinkommission Porn · Mosel – Startseite">
        <strong>WEINKOMMISSION PORN</strong>
        <span>Mosel</span>
      </a>
      <nav class="nav" aria-label="Hauptnavigation">
        <a href="#profil">Profil</a>
        <a href="#leistungen">Leistungen</a>
        <a href="#mosel">Mosel & Markt</a>
        <a href="#roland">Roland Porn</a>
        <a href={`${import.meta.env.BASE_URL}cockpit/`}>Cockpit</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
      <a class="header-cta" href="#kontakt">Anfrage senden</a>
      <details class="mobile-menu">
