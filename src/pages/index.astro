          <div class="hero-actions">
            <a class="btn primary" href="#kontakt">Wein anbieten</a>
            <a class="btn secondary" href="#kontakt">Wein suchen</a>
          </div>

          <dl class="hero-ledger" aria-label="Profil der Weinkommission">
            <div><dt>Arbeitsraum</dt><dd>Deutsche Mosel</dd></div>
            <div><dt>Markt</dt><dd>Deutschland · Europa · international</dd></div>
            <div><dt>Arbeitsweise</dt><dd>Persönlich · diskret · verlässlich</dd></div>
          </dl>
        </div>

        <div class="hero-instrument" aria-label="Kartografische Darstellung der Mosel als Arbeitsraum">
          <div class="instrument-head">
            <span>Arbeitsraum / Deutsche Mosel</span>
            <span>Trier — Koblenz</span>
          </div>

          <svg class="instrument-map" viewBox="0 0 760 620" role="img" aria-labelledby="instrument-title instrument-desc">
            <title id="instrument-title">Deutsche Mosel zwischen Trier und Koblenz</title>
            <desc id="instrument-desc">Reduzierte kartografische Interpretation des Moselverlaufs mit ausgewählten Marktorten.</desc>

            <g class="instrument-grid" aria-hidden="true">
              <path d="M0 112H760M0 236H760M0 360H760M0 484H760" />
              <path d="M126 0V620M252 0V620M378 0V620M504 0V620M630 0V620" />
            </g>

            <g class="instrument-contours" aria-hidden="true">
              <path d="M-36 566C98 494 182 585 319 498S565 392 806 476" />
              <path d="M-44 472C92 399 202 503 344 412S589 296 812 383" />
              <path d="M-30 372C121 296 215 411 366 314S603 201 806 286" />
