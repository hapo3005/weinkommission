---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Impressum | Weinkommission Porn · Mosel"
  description="Impressum der Website Weinkommission Porn · Mosel. Die rechtlich erforderlichen Unternehmensangaben werden vor dem Launch verifiziert und ergänzt."
  canonicalPath="/weinkommission/impressum/"
>
  <main class="legal" id="main">
    <div class="shell legal-inner">
      <a class="back" href={import.meta.env.BASE_URL}>← Zurück zur Startseite</a>
      <p class="kicker">Rechtliches</p>
      <h1>Impressum</h1>
      <p class="lead-legal">Diese Seite ist Teil des nicht indexierten Entwicklungsstands. Die gesetzlich erforderlichen Angaben werden erst nach Verifizierung der realen Unternehmensdaten veröffentlicht.</p>
      <section>
        <h2>Vor Launch noch erforderlich</h2>
        <ul>
          <li>vollständiger Unternehmensname und Rechtsform</li>
          <li>ladungsfähige Anschrift</li>
          <li>vertretungsberechtigte Person</li>
          <li>Telefon und E-Mail</li>
          <li>Register- und Steuerangaben, sofern einschlägig</li>
          <li>weitere Pflichtangaben abhängig von der tatsächlichen Unternehmensform</li>
        </ul>
      </section>
      <p class="status">STATUS: BLOCKED – reale Unternehmensangaben fehlen.</p>
    </div>
  </main>
</BaseLayout>

<style>
  .legal{min-height:100svh;padding:5rem 0;background:var(--paper-2)}
  .legal-inner{max-width:820px}
  .back{display:inline-block;margin-bottom:5rem;text-decoration:none;font-size:.8rem}
  .legal h1{color:var(--ink);font-size:clamp(3rem,8vw,6rem)}
  .lead-legal{font-family:var(--serif);font-size:1.25rem;line-height:1.6;color:#46514c;max-width:42rem}
  .legal section{margin-top:4rem;border-top:1px solid var(--line);padding-top:2rem}
  .legal h2{font-size:2rem}
  .legal li{margin:.6rem 0;color:#525c58}
  .status{margin-top:3rem;font-size:.72rem;letter-spacing:.12em;color:#80693f}
</style>
