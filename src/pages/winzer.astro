---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoleContextBar from '../components/RoleContextBar.astro';
import '../styles/winzer-portal-v2.css';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Winzerportal · Weinkommission Porn"
  description="Digitaler Arbeitsbereich für kooperierende Winzer der Weinkommission Porn."
  canonicalPath="/weinkommission/winzer/"
>
  <RoleContextBar role="grower" />
  <div class="portal2-app">
    <header class="portal2-header">
      <a class="portal2-brand" href={base}>
        <span class="portal2-mark">WP</span>
        <span><strong>WEINKOMMISSION PORN</strong><small>Winzerportal · Demo</small></span>
      </a>
      <span class="portal2-header-status">Registrierter Partner · Demo</span>
    </header>

    <main class="portal2-main" id="overview">
      <section class="portal2-identity dashboard-identity">
        <div>
          <p class="portal2-eyebrow">Willkommen zurück</p>
          <h1 data-portal-business>Weinhof Pellenz</h1>
          <p><span data-portal-place>Piesport</span> · <span data-portal-id>TEST-062</span></p>
        </div>
        <span class="partner-active">Partnerzugang aktiv</span>
      </section>

      <section class="grower-today" data-current-task>
        <div class="grower-today-mark" data-today-mark>!</div>
        <div class="grower-today-copy">
          <p class="portal2-eyebrow">Heute wichtig</p>
          <h2 data-task-title>Ihr aktueller Vorgang wird geladen …</h2>
          <p data-task-summary>Hier erscheint nur, was Ihre Rückmeldung benötigt.</p>
          <span class="today-status" data-task-status>—</span>
        </div>
        <button class="portal2-primary today-button" type="button" data-open-task>Jetzt erledigen →</button>
      </section>

      <section class="portal2-overview dashboard-stats" aria-label="Mein Betrieb auf einen Blick">
        <article>
          <span>Meine Partien</span>
          <strong data-lot-count>—</strong>
          <small>aktuell hinterlegt</small>
        </article>
        <article>
          <span>Verfügbar</span>
          <strong data-total-volume>—</strong>
          <small>über alle Partien</small>
        </article>
        <article>
          <span>Zugeordnet</span>
          <strong data-allocated-volume>—</strong>
          <small>laufende Bedarfe</small>
        </article>
        <article>
          <span>Betriebsprofil</span>
          <strong data-profile-stat>—</strong>
          <small data-profile-stat-copy>Profilstatus</small>
        </article>
      </section>

      <section class="portal2-section current-section" id="current">
        <div class="portal2-section-head">
          <div>
            <p class="portal2-eyebrow">Aktueller Vorgang</p>
            <h2>Was gerade mit Ihrer Partie passiert.</h2>
          </div>
          <small>Nur der für Sie relevante Vorgang – ohne interne Kommissionsdaten.</small>
        </div>

        <div class="portal2-task-grid current-grid">
          <div><span>Partie</span><strong data-task-lot>—</strong></div>
          <div><span>Wein</span><strong data-task-wine>—</strong></div>
          <div><span>Verfügbar</span><strong data-task-available>—</strong></div>
          <div><span>Zugeordnet</span><strong data-task-allocated>—</strong></div>
          <div><span>Abnehmer</span><strong>Peter Mertes</strong></div>
          <div><span>Lieferfenster</span><strong>Okt.–Dez. 2026</strong></div>
        </div>
      </section>

      <section class="portal2-edit task-editor" data-task-editor hidden>
        <button class="portal2-back" type="button" data-close-task>← Zur Übersicht</button>
        <p class="portal2-eyebrow" data-editor-kicker>Rückmeldung</p>
        <h2 data-editor-title>Angaben bestätigen</h2>
        <p data-editor-copy>Bitte prüfen Sie die vorbereiteten Angaben. Sie müssen nichts erneut vollständig eingeben.</p>

        <div class="portal2-prepared">
          <div><span>Betrieb</span><strong data-edit-business>—</strong></div>
          <div><span>Partie</span><strong data-edit-lot>—</strong></div>
          <div><span>Rebsorte / Jahrgang</span><strong data-edit-wine>—</strong></div>
          <div><span>Herkunft</span><strong data-edit-origin>—</strong></div>
        </div>

        <div class="portal2-form-grid" data-loading-fields hidden>
          <label><span>Tatsächlich verladen (Liter)</span><input data-loaded-volume inputmode="decimal" placeholder="z. B. 18.450" /></label>
          <label><span>Kennzeichen Tankwagen</span><input data-plate placeholder="z. B. WIL-AB 123" /></label>
        </div>

        <label class="portal2-confirm">
          <input type="checkbox" data-task-confirm />
          <span data-confirm-copy>Die aktuell hinterlegten Angaben sind korrekt.</span>
        </label>
        <p class="portal2-error" data-task-error hidden>Bitte die erforderlichen Angaben ergänzen und bestätigen.</p>
        <button class="portal2-primary" type="button" data-save-task>Rückmeldung senden →</button>
      </section>

      <section class="portal2-section" id="lots">
        <div class="portal2-section-head">
          <div><p class="portal2-eyebrow">Meine Partien</p><h2>Aktuell bei der Kommission hinterlegt.</h2></div>
          <small>Eine Partie beschreibt einen konkreten Wein. Ihr Betriebsprofil bleibt davon getrennt.</small>
        </div>
        <div class="portal2-lots" data-portal-lots></div>
      </section>

      <section class="portal2-profile-card dashboard-profile" id="profile">
        <div>
          <p class="portal2-eyebrow">Mein Betrieb</p>
          <h2>Betriebsprofil</h2>
          <p data-profile-copy>Ihre dauerhaften Betriebs- und Kapazitätsdaten helfen der Kommission, passende Bedarfe zuzuordnen.</p>
        </div>
        <div class="portal2-profile-meter">
          <strong data-profile-percent>0 %</strong>
          <div><i data-profile-bar></i></div>
          <a href={`${base}winzer/profil/`} data-profile-link>Betriebsprofil öffnen →</a>
        </div>
      </section>
    </main>

    <nav class="grower-bottom-nav" aria-label="Winzerportal Navigation">
      <a href="#overview" class="active"><span>⌂</span><small>Übersicht</small></a>
      <a href="#lots"><span>◫</span><small>Partien</small></a>
      <a href={`${base}winzer/profil/`}><span>○</span><small>Profil</small></a>
    </nav>
  </div>

  <script>
    import { demoGrowers, demoLots, demoRequirement, demoProcurementRows } from '../data/procurement-demo.js';
    import { runProcurement } from '../lib/procurementEngine.js';
    import { resolveActiveGrower, getGrowerProfile, getGrowerResponses, addGrowerResponse } from '../lib/demoSession.js';

    const formatLiters = value => new Intl.NumberFormat('de-DE').format(Math.round(value || 0)) + ' l';
    const account = JSON.parse(localStorage.getItem('wp-demo-grower-account') || 'null');
    const grower = resolveActiveGrower(demoGrowers, window.location.search, 'TEST-001');
    const savedProfile = getGrowerProfile(grower.growerId);
    const lots = demoLots.filter(lot => lot.growerId === grower.growerId);
    const responses = getGrowerResponses(grower.growerId);
    const responseByLot = new Map(responses.map(response => [response.lotId, response]));
    const workingRows = demoProcurementRows.map(row => {
      const response = row.growerId === grower.growerId ? responseByLot.get(row.lotId) : null;
      if (!response) return row;
      return {
        ...row,
        analysisConfirmed: response.type === 'confirmation' ? true : row.analysisConfirmed,
        treatmentsConfirmed: response.type === 'confirmation' ? true : row.treatmentsConfirmed,
        currentVolumeConfirmed: response.type === 'confirmation' ? true : row.currentVolumeConfirmed,
        transportDataComplete: response.type === 'loading' ? true : row.transportDataComplete
      };
    });
    const model = runProcurement(demoRequirement, workingRows);
    const growerRows = model.allocationRows.filter(row => row.growerId === grower.growerId);
    const allocatedRows = growerRows.filter(row => row.allocatedVolume > 0);
    const waitingRow = growerRows.find(row => row.status === 'waiting');
    const transportRow = allocatedRows.find(row => row.status === 'transport');
    const currentRow = waitingRow || transportRow || allocatedRows[0] || growerRows[0] || null;
    const allocatedVolume = allocatedRows.reduce((sum, row) => sum + row.allocatedVolume, 0);
    let taskMode = 'none';
    const totalVolume = lots.reduce((sum, lot) => sum + lot.availableVolume, 0);

    const setText = (selector, value) => {
      const el = document.querySelector(selector);
      if (el) el.textContent = value;
    };

    setText('[data-portal-business]', grower.growerName);
    setText('[data-portal-place]', grower.place);
    setText('[data-portal-id]', grower.growerId);
    setText('[data-lot-count]', String(lots.length));
    setText('[data-total-volume]', formatLiters(totalVolume));
    setText('[data-allocated-volume]', formatLiters(allocatedVolume));

    const profilePct = savedProfile?.growerId === grower.growerId
      ? (savedProfile.completeness || 0)
      : (grower.profile?.completeness || 0);
    setText('[data-profile-percent]', profilePct + ' %');
    setText('[data-profile-stat]', profilePct + ' %');
    setText('[data-profile-stat-copy]', profilePct >= 100 ? 'vollständig' : 'bitte ergänzen');
    document.querySelector('[data-profile-bar]').style.width = profilePct + '%';
    document.querySelector('[data-profile-copy]').textContent = profilePct >= 100
      ? 'Grundprofil vollständig. Änderungen können jederzeit aktualisiert werden.'
      : 'Für bessere Zuordnung fehlen noch Angaben im Betriebsprofil.';
    document.querySelector('[data-profile-link]').textContent = profilePct >= 100 ? 'Betriebsprofil öffnen →' : 'Betriebsprofil vervollständigen →';

    const todayCard = document.querySelector('[data-current-task]');
    const todayButton = document.querySelector('[data-open-task]');

    if (currentRow) {
      const statusText =
        currentRow.status === 'waiting' ? 'Rückmeldung offen' :
        currentRow.status === 'transport' ? 'Verladedaten fehlen' :
        currentRow.status === 'document' ? 'Dokument vorbereitet' :
        currentRow.allocatedVolume > 0 ? 'Zugeordnet' :
        'Verfügbar';

      setText('[data-task-status]', statusText);
      setText('[data-task-lot]', currentRow.lotId);
      setText('[data-task-wine]', currentRow.vintage + ' ' + currentRow.grape);
      setText('[data-task-available]', formatLiters(currentRow.availableVolume));
      setText('[data-task-allocated]', currentRow.allocatedVolume > 0 ? formatLiters(currentRow.allocatedVolume) : '—');
      setText('[data-edit-business]', grower.growerName);
      setText('[data-edit-lot]', currentRow.lotId);
      setText('[data-edit-wine]', currentRow.vintage + ' ' + currentRow.grape);
      setText('[data-edit-origin]', currentRow.origin);

      if (waitingRow) {
        taskMode = 'confirmation';
        const task = model.tasks.find(item => item.growerId === grower.growerId && item.lotId === waitingRow.lotId);
        setText('[data-today-mark]', '!');
        setText('[data-task-title]', task?.task || 'Eine Angabe muss bestätigt werden.');
        setText('[data-task-summary]', waitingRow.lotId + ' · ' + waitingRow.vintage + ' ' + waitingRow.grape + ' · die Kommission wartet auf Ihre Rückmeldung.');
        todayCard.classList.add('needs-action');
      } else if (transportRow) {
        taskMode = 'loading';
        setText('[data-today-mark]', '↗');
        setText('[data-task-title]', 'Verladedaten ergänzen.');
        setText('[data-task-summary]', transportRow.lotId + ' · ' + formatLiters(transportRow.allocatedVolume) + ' für ' + demoRequirement.buyer + ' zugeteilt.');
        todayCard.classList.add('needs-action');
      } else if (allocatedRows.length > 0) {
        taskMode = 'view';
        setText('[data-today-mark]', '✓');
        setText('[data-task-title]', 'Aktuell keine Rückmeldung erforderlich.');
        setText('[data-task-summary]', formatLiters(allocatedVolume) + ' sind einem laufenden Bedarf zugeteilt. Die Kommission übernimmt die nächsten Schritte.');
        todayCard.classList.add('clear');
        todayButton.textContent = 'Vorgang ansehen →';
      } else {
        setText('[data-today-mark]', '✓');
        setText('[data-task-title]', 'Heute ist nichts offen.');
        setText('[data-task-summary]', 'Ihre Partien sind aktuell hinterlegt. Sobald Ihre Rückmeldung gebraucht wird, erscheint sie hier.');
        setText('[data-task-status]', 'Keine Aktion');
        todayCard.classList.add('clear');
        todayButton.hidden = true;
      }
    } else {
      setText('[data-today-mark]', '✓');
      setText('[data-task-title]', 'Heute ist nichts offen.');
      setText('[data-task-summary]', 'Aktuell sind keine Partien hinterlegt, die eine Rückmeldung benötigen.');
      setText('[data-task-status]', 'Keine Aktion');
      todayCard.classList.add('clear');
      todayButton.hidden = true;
      document.querySelector('#current').hidden = true;
    }

    const lotRowsById = new Map(growerRows.map(row => [row.lotId, row]));
    const lotsEl = document.querySelector('[data-portal-lots]');
    lotsEl.innerHTML = lots.map(lot => {
      const row = lotRowsById.get(lot.lotId);
      const responded = responseByLot.has(lot.lotId);
      const status = responded
        ? 'bestätigt'
        : row?.allocatedVolume > 0 ? 'zugeteilt'
        : row?.status === 'waiting' ? 'Angabe offen'
        : 'verfügbar';
      return `
        <article>
          <div><strong>${lot.lotId}</strong><small>${lot.vintage} ${lot.grape} · ${lot.origin}</small></div>
          <div><span>Verfügbar</span><strong>${formatLiters(lot.availableVolume)}</strong></div>
          <div><span>Zugeordnet</span><strong>${row?.allocatedVolume > 0 ? formatLiters(row.allocatedVolume) : '—'}</strong></div>
          <em>${status}</em>
        </article>
      `;
    }).join('');

    const editor = document.querySelector('[data-task-editor]');
    const loadingFields = document.querySelector('[data-loading-fields]');

    todayButton.addEventListener('click', () => {
      if (taskMode === 'view') {
        document.querySelector('#current').scrollIntoView({behavior:'smooth', block:'start'});
        return;
      }

      if (taskMode === 'loading') {
        setText('[data-editor-kicker]', 'Verladung');
        setText('[data-editor-title]', 'Verladedaten ergänzen');
        setText('[data-editor-copy]', 'Bitte tragen Sie nur die Angaben ein, die erst bei der tatsächlichen Verladung feststehen.');
        setText('[data-confirm-copy]', 'Die Verladedaten sind korrekt und können für Transport und Begleitdokument verwendet werden.');
        loadingFields.hidden = false;
        document.querySelector('[data-loaded-volume]').value = String(currentRow?.allocatedVolume || currentRow?.availableVolume || '');
      } else {
        setText('[data-editor-kicker]', 'Rückmeldung');
        setText('[data-editor-title]', 'Partiedaten bestätigen');
        setText('[data-editor-copy]', 'Bitte prüfen Sie die vorbereiteten Angaben. Eine erneute vollständige Eingabe ist nicht erforderlich.');
        setText('[data-confirm-copy]', 'Die aktuell hinterlegten Angaben zu dieser Partie sind korrekt.');
        loadingFields.hidden = true;
      }

      todayCard.hidden = true;
      editor.hidden = false;
      editor.scrollIntoView({behavior:'smooth', block:'start'});
    });

    document.querySelector('[data-close-task]').addEventListener('click', () => {
      editor.hidden = true;
      todayCard.hidden = false;
    });

    document.querySelector('[data-save-task]').addEventListener('click', () => {
      const volume = document.querySelector('[data-loaded-volume]').value.trim();
      const plate = document.querySelector('[data-plate]').value.trim();
      const confirmed = document.querySelector('[data-task-confirm]').checked;
      const error = document.querySelector('[data-task-error]');

      if (!confirmed || (taskMode === 'loading' && (!volume || !plate))) {
        error.hidden = false;
        return;
      }

      error.hidden = true;
      addGrowerResponse({
        growerId: grower.growerId,
        lotId: currentRow?.lotId,
        type: taskMode,
        loadedVolume: taskMode === 'loading' ? volume : null,
        plate: taskMode === 'loading' ? plate : null,
        confirmedAt: new Date().toISOString(),
        demo: true
      });

      editor.hidden = true;
      todayCard.hidden = false;
      todayCard.classList.remove('needs-action');
      todayCard.classList.add('clear');
      setText('[data-today-mark]', '✓');
      setText('[data-task-title]', 'Rückmeldung übermittelt.');
      setText('[data-task-summary]', 'Die Weinkommission hat Ihre Bestätigung im Demo-Workflow erhalten.');
      setText('[data-task-status]', 'Erledigt');
      todayButton.hidden = true;
    });
  </script>
</BaseLayout>
