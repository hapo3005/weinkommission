---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoleContextBar from '../components/RoleContextBar.astro';
import '../styles/winzer-portal-v2.css';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Winzerportal · Weinkommission Porn"
  description="Digitaler Arbeitsbereich für kooperierende Winzer der Weinkommission Porn."
  canonicalPath="/weinkommission/winzer/"
>
  <RoleContextBar role="grower" />
  <div class="portal2-app">
    <header class="portal2-header">
      <a class="portal2-brand" href={base}>
        <span class="portal2-mark">WP</span>
        <span><strong>WEINKOMMISSION PORN</strong><small>Winzerportal · Demo</small></span>
      </a>
      <div class="portal2-header-actions">
        <a class="portal2-quiet" href={`${base}winzer/registrieren/`}>Zugang / Registrierung</a>
      </div>
    </header>

    <main class="portal2-main" id="main">
      <section class="portal2-identity">
        <div>
          <p class="portal2-eyebrow">Ihr Arbeitsbereich</p>
          <h1 data-portal-business>Weingut Ahrensberg & Sohn</h1>
          <p><span data-portal-place>Bernkastel-Kues</span> · <span data-portal-id>TEST-001</span></p>
        </div>
        <span class="portal2-demo">Demo · keine Echtdaten</span>
      </section>

      <section class="portal2-profile-card">
        <div>
          <p class="portal2-eyebrow">Betriebsprofil</p>
          <h2>Die Kommission kennt Ihren Betrieb.</h2>
          <p data-profile-copy>Ergänzen Sie Größe, Jahresproduktion, Rebsorten und Kapazitäten, damit Bedarfe passend zugeordnet werden können.</p>
        </div>
        <div class="portal2-profile-meter">
          <strong data-profile-percent>0 %</strong>
          <div><i data-profile-bar></i></div>
          <a href={`${base}winzer/profil/`} data-profile-link>Betriebsprofil vervollständigen →</a>
        </div>
      </section>

      <section class="portal2-overview">
        <article>
          <span>Aktive Partien</span>
          <strong data-lot-count>—</strong>
          <small>im aktuellen Testbestand</small>
        </article>
        <article>
          <span>Verfügbare Menge</span>
          <strong data-total-volume>—</strong>
          <small>über alle Partien</small>
        </article>
        <article>
          <span>Aktuell zugeteilt</span>
          <strong data-allocated-volume>—</strong>
          <small>für laufende Bedarfe</small>
        </article>
      </section>

      <section class="portal2-task" data-current-task>
        <div class="portal2-task-head">
          <div>
            <p class="portal2-eyebrow">Aktueller Vorgang</p>
            <h2 data-task-title>Vorgang wird geladen …</h2>
          </div>
          <span data-task-status>—</span>
        </div>

        <div class="portal2-task-grid">
          <div><span>Partie</span><strong data-task-lot>—</strong></div>
          <div><span>Wein</span><strong data-task-wine>—</strong></div>
          <div><span>Verfügbar</span><strong data-task-available>—</strong></div>
          <div><span>Zugeordnet</span><strong data-task-allocated>—</strong></div>
          <div><span>Abnehmer</span><strong>Peter Mertes</strong></div>
          <div><span>Lieferfenster</span><strong>Okt.–Dez. 2026</strong></div>
        </div>

        <button class="portal2-primary" type="button" data-open-task>Vorgang prüfen →</button>
      </section>

      <section class="portal2-edit" data-task-editor hidden>
        <button class="portal2-back" type="button" data-close-task>← Zurück</button>
        <p class="portal2-eyebrow">Nur fehlende Angaben ergänzen</p>
        <h2>Was wurde tatsächlich verladen?</h2>
        <p>Bekannte Betriebs- und Partiedaten werden übernommen. Sie ergänzen nur die Angaben, die erst bei der Verladung feststehen.</p>

        <div class="portal2-prepared">
          <div><span>Betrieb</span><strong data-edit-business>—</strong></div>
          <div><span>Partie</span><strong data-edit-lot>—</strong></div>
          <div><span>Rebsorte / Jahrgang</span><strong data-edit-wine>—</strong></div>
          <div><span>Herkunft</span><strong data-edit-origin>—</strong></div>
        </div>

        <div class="portal2-form-grid">
          <label><span>Tatsächlich verladen (Liter)</span><input data-loaded-volume inputmode="decimal" placeholder="z. B. 18.450" /></label>
          <label><span>Kennzeichen Tankwagen</span><input data-plate placeholder="z. B. WIL-AB 123" /></label>
        </div>

        <label class="portal2-confirm">
          <input type="checkbox" data-task-confirm />
          <span>Die Angaben stimmen und können für Transport und Begleitdokument verwendet werden.</span>
        </label>
        <p class="portal2-error" data-task-error hidden>Bitte Literzahl, Kennzeichen und Bestätigung ergänzen.</p>
        <button class="portal2-primary" type="button" data-save-task>Angaben bestätigen →</button>
      </section>

      <section class="portal2-section">
        <div class="portal2-section-head">
          <div><p class="portal2-eyebrow">Meine Partien</p><h2>Was aktuell hinterlegt ist.</h2></div>
          <small>Partien und Betriebsprofil sind getrennt. Eine Partie beschreibt einen konkreten Wein.</small>
        </div>
        <div class="portal2-lots" data-portal-lots></div>
      </section>

      <section class="portal2-section">
        <div class="portal2-section-head">
          <div><p class="portal2-eyebrow">Zusammenarbeit</p><h2>Nur das, was Sie betrifft.</h2></div>
        </div>
        <div class="portal2-help-grid">
          <a href={`${base}winzer/profil/`}><strong>Betriebsprofil</strong><small>Dauerhafte Betriebs- und Kapazitätsdaten pflegen</small><span>→</span></a>
          <a href={`${base}winzer/registrieren/`}><strong>Zugang</strong><small>Einladung oder Registrierungsdemo öffnen</small><span>→</span></a>
        </div>
      </section>
    </main>
  </div>

  <script>
    import { demoGrowers, demoLots, demoRequirement, demoProcurementRows } from '../data/procurement-demo.js';
    import { runProcurement } from '../lib/procurementEngine.js';

    const formatLiters = value => new Intl.NumberFormat('de-DE').format(Math.round(value || 0)) + ' l';
    const account = JSON.parse(localStorage.getItem('wp-demo-grower-account') || 'null');
    const savedProfile = JSON.parse(localStorage.getItem('wp-demo-grower-profile') || 'null');
    const selectedId = account?.growerId || 'TEST-001';
    const grower = demoGrowers.find(item => item.growerId === selectedId) || demoGrowers[0];
    const lots = demoLots.filter(lot => lot.growerId === grower.growerId);
    const model = runProcurement(demoRequirement, demoProcurementRows);
    const growerRows = model.allocationRows.filter(row => row.growerId === grower.growerId);
    const allocatedRows = growerRows.filter(row => row.allocatedVolume > 0);
    const currentRow = allocatedRows[0] || growerRows.find(row => row.status === 'waiting') || growerRows[0] || null;
    const allocatedVolume = allocatedRows.reduce((sum, row) => sum + row.allocatedVolume, 0);
    const totalVolume = lots.reduce((sum, lot) => sum + lot.availableVolume, 0);

    const setText = (selector, value) => {
      const el = document.querySelector(selector);
      if (el) el.textContent = value;
    };

    setText('[data-portal-business]', account?.businessName || grower.growerName);
    setText('[data-portal-place]', account?.place || grower.place);
    setText('[data-portal-id]', grower.growerId);
    setText('[data-lot-count]', String(lots.length));
    setText('[data-total-volume]', formatLiters(totalVolume));
    setText('[data-allocated-volume]', formatLiters(allocatedVolume));

    const profilePct = savedProfile?.growerId === grower.growerId
      ? (savedProfile.completeness || 0)
      : (grower.profile?.completeness || 0);
    setText('[data-profile-percent]', profilePct + ' %');
    document.querySelector('[data-profile-bar]').style.width = profilePct + '%';
    document.querySelector('[data-profile-copy]').textContent = profilePct >= 100
      ? 'Grundprofil vollständig. Änderungen können jederzeit aktualisiert werden.'
      : 'Für bessere Zuordnung fehlen noch Angaben im Betriebsprofil.';
    document.querySelector('[data-profile-link]').textContent = profilePct >= 100 ? 'Betriebsprofil öffnen →' : 'Betriebsprofil vervollständigen →';

    if (currentRow) {
      const statusText =
        currentRow.status === 'waiting' ? 'Rückmeldung erforderlich' :
        currentRow.status === 'transport' ? 'Transportdaten fehlen' :
        currentRow.status === 'document' ? 'Dokument vorbereitet' :
        currentRow.allocatedVolume > 0 ? 'Für Bedarf vorbereitet' :
        'Aktuell keine Zuteilung';

      setText('[data-task-title]', currentRow.allocatedVolume > 0 ? 'Ihre Partie ist einem Bedarf zugeteilt.' : 'Partiedaten prüfen.');
      setText('[data-task-status]', statusText);
      setText('[data-task-lot]', currentRow.lotId);
      setText('[data-task-wine]', currentRow.vintage + ' ' + currentRow.grape);
      setText('[data-task-available]', formatLiters(currentRow.availableVolume));
      setText('[data-task-allocated]', currentRow.allocatedVolume > 0 ? formatLiters(currentRow.allocatedVolume) : '—');
      setText('[data-edit-business]', account?.businessName || grower.growerName);
      setText('[data-edit-lot]', currentRow.lotId);
      setText('[data-edit-wine]', currentRow.vintage + ' ' + currentRow.grape);
      setText('[data-edit-origin]', currentRow.origin);
    }

    const lotRowsById = new Map(growerRows.map(row => [row.lotId, row]));
    const lotsEl = document.querySelector('[data-portal-lots]');
    lotsEl.innerHTML = lots.map(lot => {
      const row = lotRowsById.get(lot.lotId);
      const status = row?.allocatedVolume > 0 ? 'zugeteilt' : row?.status === 'waiting' ? 'Angabe offen' : 'verfügbar';
      return `
        <article>
          <div><strong>${lot.lotId}</strong><small>${lot.vintage} ${lot.grape} · ${lot.origin}</small></div>
          <div><span>Verfügbar</span><strong>${formatLiters(lot.availableVolume)}</strong></div>
          <em>${status}</em>
        </article>
      `;
    }).join('');

    const taskSection = document.querySelector('[data-current-task]');
    const editor = document.querySelector('[data-task-editor]');
    document.querySelector('[data-open-task]').addEventListener('click', () => {
      taskSection.hidden = true;
      editor.hidden = false;
      editor.scrollIntoView({behavior:'smooth', block:'start'});
    });
    document.querySelector('[data-close-task]').addEventListener('click', () => {
      editor.hidden = true;
      taskSection.hidden = false;
    });

    document.querySelector('[data-save-task]').addEventListener('click', () => {
      const volume = document.querySelector('[data-loaded-volume]').value.trim();
      const plate = document.querySelector('[data-plate]').value.trim();
      const confirmed = document.querySelector('[data-task-confirm]').checked;
      const error = document.querySelector('[data-task-error]');

      if (!volume || !plate || !confirmed) {
        error.hidden = false;
        return;
      }

      error.hidden = true;
      localStorage.setItem('wp-demo-loading-confirmation', JSON.stringify({
        growerId: grower.growerId,
        lotId: currentRow?.lotId,
        loadedVolume: volume,
        plate,
        confirmedAt: new Date().toISOString()
      }));

      editor.hidden = true;
      taskSection.hidden = false;
      setText('[data-task-status]', 'Verladedaten bestätigt');
      document.querySelector('[data-open-task]').textContent = 'Angaben erneut ansehen →';
    });
  </script>
</BaseLayout>
