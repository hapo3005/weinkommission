---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoleContextBar from '../components/RoleContextBar.astro';
import '../styles/cockpit.css';
import '../styles/cockpit-home.css';
import { demoRequirement, demoGrowers, demoLots, demoProcurementRows } from '../data/procurement-demo.js';
import { runProcurement, formatLiters } from '../lib/procurementEngine.js';

const base = import.meta.env.BASE_URL;
const model = runProcurement(demoRequirement, demoProcurementRows);
const blueBandCount = demoGrowers.filter(grower => grower.supplierGroups.includes('Blaues Band')).length;
const topTasks = model.tasks.slice(0, 5);
const topExceptions = model.exceptions.slice(0, 3);
const topTransports = model.transports.slice(0, 5);
const coveragePercent = Math.round(model.coverage * 100);
const dateLabel = new Intl.DateTimeFormat('de-DE', {
  weekday: 'long',
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Berlin'
}).format(new Date());
---

<BaseLayout
  title="Porn Cockpit · Übersicht"
  description="Interne Tagesübersicht der Weinkommission Porn für Winzer, Bedarfe, Transporte und Begleitdokumente."
  canonicalPath="/weinkommission/cockpit/"
>
  <RoleContextBar role="internal" />
  <div class="cockpit-app home-app">
    <aside class="sidebar" aria-label="Cockpit Navigation">
      <a class="cockpit-brand" href={base}>
        <span class="brand-mark">WP</span>
        <span><strong>WEINKOMMISSION PORN</strong><small>Mosel · Cockpit</small></span>
      </a>

      <nav class="side-nav">
        <a class="active" href={`${base}cockpit/`} aria-current="page"><span class="nav-icon">⌂</span><span>Übersicht</span></a>
        <a href={`${base}cockpit/winzer/`}><span class="nav-icon">○</span><span>Winzer</span></a>
        <a href={`${base}cockpit/grossbedarf/`}><span class="nav-icon">◎</span><span>Großbedarf</span></a>
        <a href={`${base}cockpit/grossbedarf/#transporte`}><span class="nav-icon">↗</span><span>Transporte</span></a>
        <a href={`${base}cockpit/begleitdokument/`}><span class="nav-icon">▤</span><span>Begleitdokumente</span></a>
      </nav>

      <div class="sidebar-foot">
        <div class="api-state">
          <span class="state-dot pending"></span>
          <div><strong>Demo-System</strong><small>Testdaten · noch ohne Backend</small></div>
        </div>
        <a class="back-link" href={base}>← Öffentliche Website</a>
      </div>
    </aside>

    <main class="cockpit-main home-main" id="main">
      <header class="home-header">
        <div>
          <p class="overline">{dateLabel}</p>
          <h1>Guten Morgen, Nadine.</h1>
          <p>Du siehst hier nur das, was heute eine Entscheidung, Rückmeldung oder Kontrolle braucht.</p>
        </div>
        <div class="home-header-actions">
          <span class="demo-state">Demo · synthetische Daten</span>
        </div>
      </header>

      <section class="home-kpis" aria-label="Tageskennzahlen">
        <a href={`${base}cockpit/winzer/`}>
          <span>Kooperationspartner</span>
          <strong>{demoGrowers.length}</strong>
          <small>{blueBandCount} davon Blaues Band · Testzuordnung</small>
        </a>
        <a href={`${base}cockpit/grossbedarf/`}>
          <span>Aktiver Großbedarf</span>
          <strong data-home-coverage-kpi>{coveragePercent} %</strong>
          <small data-home-remaining-kpi>{formatLiters(model.remainingVolume)} noch offen</small>
        </a>
        <a href="#aufmerksamkeit">
          <span>Offene Rückmeldungen</span>
          <strong data-home-open-kpi>{model.tasks.length}</strong>
          <small data-home-open-copy>{model.stats.waitingGrowers} Betriebe betroffen</small>
        </a>
        <a href={`${base}cockpit/grossbedarf/#transporte`}>
          <span>Erzeugte Transporte</span>
          <strong>{model.stats.transports}</strong>
          <small>{model.stats.documentsReady} Dokumente bereits vorbereitet</small>
        </a>
      </section>

      <section class="home-section attention-home" id="aufmerksamkeit">
        <div class="home-section-head">
          <div>
            <p class="overline">Heute braucht dich</p>
            <h2>Ausnahmen statt Routine.</h2>
          </div>
          <p>Alles, was vollständig ist, läuft im Modell weiter. Hier erscheinen nur fehlende Angaben oder fachliche Abweichungen.</p>
        </div>

        <div class="attention-home-grid">
          <div class="attention-home-list" data-home-attention-list>
            {topTasks.length === 0 && topExceptions.length === 0 ? (
              <article class="home-task clear">
                <span>✓</span>
                <div><strong>Keine offenen Aufgaben</strong><small>Alle Vorgänge können automatisch weiterlaufen.</small></div>
              </article>
            ) : (
              <>
                {topTasks.map(task => (
                  <a class="home-task waiting" href={`${base}cockpit/winzer/${task.growerId}/`}>
                    <span>↻</span>
                    <div>
                      <strong>{task.task}</strong>
                      <small>{task.growerName} · {task.lotId}</small>
                    </div>
                    <em>Winzer →</em>
                  </a>
                ))}
                {topExceptions.map(item => (
                  <a class="home-task exception" href={`${base}cockpit/winzer/${item.growerId}/`}>
                    <span>!</span>
                    <div>
                      <strong>Ausnahme prüfen</strong>
                      <small>{item.growerName} · {item.detail}</small>
                    </div>
                    <em>Prüfen →</em>
                  </a>
                ))}
              </>
            )}
          </div>

          <aside class="automation-summary">
            <p class="overline">Was bereits automatisch läuft</p>
            <div><span>fachlich passende Betriebe</span><strong data-home-matching>{model.stats.matchingGrowers}</strong></div>
            <div><span>logistisch geeignet</span><strong data-home-logistics>{model.stats.logisticallyCapableGrowers}</strong></div>
            <div><span>automatisch zuteilbar</span><strong data-home-auto>{model.stats.autoAllocatableGrowers}</strong></div>
            <div><span>Partien im Verbund-Scope</span><strong data-home-lots>{model.stats.totalLots}</strong></div>
          </aside>
        </div>
      </section>

      <section class="home-section">
        <div class="home-section-head compact">
          <div>
            <p class="overline">Laufender Großbedarf</p>
            <h2>{demoRequirement.buyer} × {demoRequirement.supplierGroup}</h2>
          </div>
          <a class="home-link" href={`${base}cockpit/grossbedarf/`}>Vorgang öffnen →</a>
        </div>

        <div class="need-card">
          <div class="need-main">
            <span class="need-code">{demoRequirement.id}</span>
            <strong>{demoRequirement.vintage} {demoRequirement.grape} · {demoRequirement.origin}</strong>
            <small>Lieferfenster {demoRequirement.deliveryWindow}</small>
          </div>
          <div class="need-progress">
            <div><span data-home-allocated>{formatLiters(model.allocatedVolume)} zugeteilt</span><strong data-home-coverage>{coveragePercent} %</strong></div>
            <div class="need-track"><i data-home-coverage-bar style={`width:${Math.min(model.coverage * 100, 100)}%`}></i></div>
            <small data-home-remaining>{formatLiters(model.remainingVolume)} fehlen bis zur Zielmenge von {formatLiters(demoRequirement.targetVolume)}</small>
          </div>
          <div class="need-stats">
            <div><span>Betriebe zugeteilt</span><strong data-home-growers-allocated>{model.stats.growersAllocated}</strong></div>
            <div><span>Partien passend</span><strong data-home-eligible-lots>{model.stats.eligibleLots}</strong></div>
          </div>
        </div>
      </section>

      <section class="home-section">
        <div class="home-section-head compact">
          <div>
            <p class="overline">Transporte & Dokumente</p>
            <h2>Was als Nächstes bewegt wird.</h2>
          </div>
          <a class="home-link" href={`${base}cockpit/grossbedarf/#transporte`}>Alle Transporte →</a>
        </div>

        <div class="transport-home-list" data-home-transport-list>
          {topTransports.map(transport => (
            <a href={`${base}cockpit/winzer/${transport.growerId}/`}>
              <span class="transport-home-id">{transport.transportId}</span>
              <div><strong>{transport.growerName}</strong><small>{transport.lotId} · {formatLiters(transport.volume)}</small></div>
              <em class:list={['transport-home-state', transport.state]}>
                {transport.state === 'document-ready' ? 'Dokument vorbereitet' : transport.state === 'prepared' ? 'Transport vorbereitet' : 'Verladedaten fehlen'}
              </em>
              <span class="transport-home-open">→</span>
            </a>
          ))}
        </div>
      </section>

      <section class="home-section access-home">
        <div class="home-section-head compact">
          <div>
            <p class="overline">Portalzugänge</p>
            <h2>Registrierungen & Einladungen</h2>
          </div>
          <a class="home-link" href={`${base}cockpit/winzer/`}>Winzerkartei →</a>
        </div>

        <div class="home-access-empty" data-home-access-empty>
          <strong>Keine lokale Demo-Aktivität.</strong>
          <small>Aktiviere einen Winzerzugang oder sende eine Kooperationsanfrage; sie erscheint hier sofort.</small>
        </div>
        <div class="home-access-feed" data-home-access-feed hidden></div>
      </section>

      <section class="home-section external-home">
        <div class="home-section-head compact">
          <div>
            <p class="overline">Externe Partneraktivität</p>
            <h2>Neue Bedarfe & bestätigte Abholungen</h2>
          </div>
          <a class="home-link" href={`${base}demo/`}>Externe Rollen ansehen →</a>
        </div>

        <div class="home-access-empty" data-external-empty>
          <strong>Noch keine externe Demo-Aktivität.</strong>
          <small>Bedarf im Abnehmerportal oder Abholung im Fahrerportal bestätigen; die Aktivität erscheint hier sofort.</small>
        </div>
        <div class="home-access-feed" data-external-feed hidden></div>
      </section>

      <section class="home-section quick-home">
        <div class="home-section-head compact">
          <div><p class="overline">Schnellzugriff</p><h2>Direkt in den Arbeitsbereich.</h2></div>
        </div>
        <div class="quick-home-grid">
          <a href={`${base}cockpit/winzer/`}><strong>Winzerkartei</strong><small>Betriebe, Profile, Partien und Portalzugänge</small><span>→</span></a>
          <a href={`${base}cockpit/grossbedarf/`}><strong>Großbedarf</strong><small>Matching, Zuteilung und Ausnahmen</small><span>→</span></a>
          <a href={`${base}cockpit/begleitdokument/`}><strong>Begleitdokumente</strong><small>Dokumentdaten prüfen und vorbereiten</small><span>→</span></a>
        </div>
      </section>
    </main>
  </div>

  <script>
    import { demoRequirement, demoProcurementRows } from '../data/procurement-demo.js';
    import { runProcurement } from '../lib/procurementEngine.js';
    import { getAllGrowerResponses } from '../lib/demoSession.js';

    const empty = document.querySelector('[data-home-access-empty]');
    const feed = document.querySelector('[data-home-access-feed]');

    function escapeHtml(value = '') {
      return String(value).replace(/[&<>"']/g, char => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'
      })[char]);
    }

    function renderWorkflowState() {
      const allResponses = getAllGrowerResponses();
      const workingRows = demoProcurementRows.map(row => {
        const responses = allResponses[row.growerId] || [];
        const response = responses.find(item => item.lotId === row.lotId);
        if (!response) return row;
        return {
          ...row,
          analysisConfirmed: response.type === 'confirmation' ? true : row.analysisConfirmed,
          treatmentsConfirmed: response.type === 'confirmation' ? true : row.treatmentsConfirmed,
          currentVolumeConfirmed: response.type === 'confirmation' ? true : row.currentVolumeConfirmed,
          transportDataComplete: response.type === 'loading' ? true : row.transportDataComplete
        };
      });

      const liveModel = runProcurement(demoRequirement, workingRows);
      const format = value => new Intl.NumberFormat('de-DE').format(Math.round(value || 0)) + ' l';
      const pct = Math.round(liveModel.coverage * 100);

      document.querySelector('[data-home-coverage-kpi]').textContent = pct + ' %';
      document.querySelector('[data-home-remaining-kpi]').textContent = format(liveModel.remainingVolume) + ' noch offen';
      document.querySelector('[data-home-open-kpi]').textContent = String(liveModel.tasks.length);
      document.querySelector('[data-home-open-copy]').textContent = liveModel.stats.waitingGrowers + ' Betriebe betroffen';
      document.querySelector('[data-home-matching]').textContent = String(liveModel.stats.matchingGrowers);
      document.querySelector('[data-home-logistics]').textContent = String(liveModel.stats.logisticallyCapableGrowers);
      document.querySelector('[data-home-auto]').textContent = String(liveModel.stats.autoAllocatableGrowers);
      document.querySelector('[data-home-lots]').textContent = String(liveModel.stats.totalLots);
      document.querySelector('[data-home-allocated]').textContent = format(liveModel.allocatedVolume) + ' zugeteilt';
      document.querySelector('[data-home-coverage]').textContent = pct + ' %';
      document.querySelector('[data-home-coverage-bar]').style.width = Math.min(liveModel.coverage * 100,100) + '%';
      document.querySelector('[data-home-remaining]').textContent = format(liveModel.remainingVolume) + ' fehlen bis zur Zielmenge von ' + format(demoRequirement.targetVolume);
      document.querySelector('[data-home-growers-allocated]').textContent = String(liveModel.stats.growersAllocated);
      document.querySelector('[data-home-eligible-lots]').textContent = String(liveModel.stats.eligibleLots);

      const attention = document.querySelector('[data-home-attention-list]');
      const taskItems = liveModel.tasks.slice(0,5).map(task => `
        <a class="home-task waiting" href="${import.meta.env.BASE_URL}cockpit/winzer/${encodeURIComponent(task.growerId)}/">
          <span>↻</span>
          <div><strong>${escapeHtml(task.task)}</strong><small>${escapeHtml(task.growerName)} · ${escapeHtml(task.lotId)}</small></div>
          <em>Winzer →</em>
        </a>`);
      const exceptionItems = liveModel.exceptions.slice(0,Math.max(0,5-taskItems.length)).map(item => `
        <a class="home-task exception" href="${import.meta.env.BASE_URL}cockpit/winzer/${encodeURIComponent(item.growerId)}/">
          <span>!</span>
          <div><strong>Ausnahme prüfen</strong><small>${escapeHtml(item.growerName)} · ${escapeHtml(item.detail)}</small></div>
          <em>Prüfen →</em>
        </a>`);
      const attentionItems = [...taskItems,...exceptionItems];
      attention.innerHTML = attentionItems.length ? attentionItems.join('') : `
        <article class="home-task clear">
          <span>✓</span>
          <div><strong>Keine offenen Aufgaben</strong><small>Alle Vorgänge können automatisch weiterlaufen.</small></div>
        </article>`;

      const confirmations = JSON.parse(localStorage.getItem('wp-demo-driver-confirmations') || '[]');
      const confirmationIds = new Set(confirmations.map(item => item.transportId));
      const transportList = document.querySelector('[data-home-transport-list]');
      transportList.innerHTML = liveModel.transports.slice(0,5).map(transport => {
        const confirmed = confirmationIds.has(transport.transportId);
        const label = confirmed
          ? 'Abholung bestätigt'
          : transport.state === 'document-ready' ? 'Dokument vorbereitet'
          : transport.state === 'prepared' ? 'Transport vorbereitet'
          : 'Verladedaten fehlen';
        return `
          <a href="${import.meta.env.BASE_URL}cockpit/winzer/${encodeURIComponent(transport.growerId)}/">
            <span class="transport-home-id">${escapeHtml(transport.transportId)}</span>
            <div><strong>${escapeHtml(transport.growerName)}</strong><small>${escapeHtml(transport.lotId)} · ${format(transport.volume)}</small></div>
            <em class="transport-home-state ${confirmed ? 'document-ready' : escapeHtml(transport.state)}">${label}</em>
            <span class="transport-home-open">→</span>
          </a>`;
      }).join('');
    }

    const account = JSON.parse(localStorage.getItem('wp-demo-grower-account') || 'null');
    const requests = JSON.parse(localStorage.getItem('wp-demo-registration-requests') || '[]');
    const profile = JSON.parse(localStorage.getItem('wp-demo-grower-profile') || 'null');
    const items = [];

    if (account) {
      items.push(`
        <article class="home-access-item active">
          <span>Aktiv</span>
          <div><strong>${escapeHtml(account.businessName || account.growerId)}</strong><small>${escapeHtml(account.growerId)} · Portalzugang aktiviert${profile ? ' · Profil ' + (profile.completeness || 0) + ' %' : ''}</small></div>
          <em>bestehende Betriebsakte verknüpft</em>
        </article>
      `);
    }

    requests.slice(0, 4).forEach(request => {
      items.push(`
        <article class="home-access-item review">
          <span>Prüfung</span>
          <div><strong>${escapeHtml(request.businessName)}</strong><small>${escapeHtml(request.place)} · neue Kooperationsanfrage</small></div>
          <em>${request.blueBandClaimed ? 'Blaues Band angegeben · unbestätigt' : 'Verbundzugehörigkeit offen'}</em>
        </article>
      `);
    });

    if (items.length) {
      empty.hidden = true;
      feed.hidden = false;
      feed.innerHTML = items.join('');
    }

    const externalEmpty = document.querySelector('[data-external-empty]');
    const externalFeed = document.querySelector('[data-external-feed]');
    const buyerRequests = JSON.parse(localStorage.getItem('wp-demo-buyer-requests') || '[]');
    const driverConfirmations = JSON.parse(localStorage.getItem('wp-demo-driver-confirmations') || '[]');
    const externalItems = [];

    buyerRequests.slice(0, 5).forEach(request => {
      externalItems.push(`
        <article class="home-access-item buyer">
          <span>Bedarf</span>
          <div>
            <strong>${escapeHtml(request.company)} · ${escapeHtml(request.vintage)} ${escapeHtml(request.grape)}</strong>
            <small>${escapeHtml(request.targetVolume)} · ${escapeHtml(request.origin)} · ${escapeHtml(request.deliveryWindow)}</small>
          </div>
          <em>Prüfung erforderlich</em>
        </article>
      `);
    });

    driverConfirmations.slice(0, 5).forEach(item => {
      externalItems.push(`
        <article class="home-access-item driver">
          <span>Abholung</span>
          <div>
            <strong>${escapeHtml(item.growerName)} · ${escapeHtml(item.lotId)}</strong>
            <small>${escapeHtml(item.transportId)} · ${new Intl.NumberFormat('de-DE').format(item.loadedVolume || 0)} l · ${escapeHtml(item.plate)}</small>
          </div>
          <em>vom Fahrer bestätigt</em>
        </article>
      `);
    });

    if (externalItems.length) {
      externalEmpty.hidden = true;
      externalFeed.hidden = false;
      externalFeed.innerHTML = externalItems.join('');
    }

    renderWorkflowState();
  </script>
</BaseLayout>
